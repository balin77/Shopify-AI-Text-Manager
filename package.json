{
  "name": "shopify-api-connector",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "build": "prisma generate && remix vite:build && node scripts/strip-client-sourcemaps.mjs",
    "postinstall": "prisma generate || true",
    "postdeploy": "node scripts/migrate-baseline.js",
    "dev": "remix vite:dev",
    "start": "node scripts/validate-env.js && node start.js",
    "start:migrate": "node scripts/migrate-baseline.js && npm run start",
    "start:with-migrations": "node scripts/run-all-migrations.js && npm run start",
    "start:production": "node scripts/run-all-migrations.js && node scripts/validate-env.js && node start.js",
    "migrate:fix": "node scripts/fix-failed-migrations.js",
    "migrate:product-translations": "tsx scripts/migrate-product-translations.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "node scripts/migrate-baseline.js",
    "prisma:migrate:predeploy": "node scripts/run-migration.js",
    "db:cleanup": "node scripts/cleanup-database.js",
    "shopify": "shopify app dev",
    "deploy": "shopify app deploy",
    "web:old": "tsx web-app/server.ts",
    "oauth:old": "tsx src/oauth-setup.ts",
    "validate:env": "node scripts/validate-env.js",
    "build:flags": "node scripts/build-storefront-flags.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/generative-ai": "^0.24.1",
    "@huggingface/inference": "^4.13.5",
    "@prisma/client": "^6.19.2",
    "@remix-run/express": "^2.17.5",
    "@remix-run/node": "^2.17.5",
    "@remix-run/react": "^2.17.5",
    "@sentry/node": "^8.55.2",
    "@sentry/react": "^8.55.2",
    "@shopify/polaris": "^13.9.5",
    "@shopify/shopify-api": "^14.0.0",
    "@shopify/shopify-app-remix": "^5.0.0",
    "@shopify/shopify-app-session-storage-prisma": "^10.0.0",
    "@types/express": "^5.0.6",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "express": "^4.22.1",
    "express-rate-limit": "8.5.2",
    "franc-min": "^6.2.0",
    "isomorphic-dompurify": "^2.35.0",
    "morgan": "^1.10.1",
    "openai": "^6.15.0",
    "prisma": "^6.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remix": "^2.17.5",
    "sharp": "^0.34.5",
    "winston": "^3.19.0",
    "zod": "^4.3.5"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "optionalDependencies": {
    "railway": "^2.0.17"
  },
  "overrides": {
    "tar": "^7.5.6",
    "esbuild": "^0.27.2",
    "estree-util-value-to-estree": "1.3.0",
    "remark-mdx-frontmatter": "1.1.1",
    "dompurify": "^3.4.5"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.17.5",
    "@sentry/vite-plugin": "^2.23.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/sharp": "^0.32.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "esbuild": "^0.27.2",
    "flag-icons": "^7.5.0",
    "happy-dom": "^20.3.1",
    "jsdom": "^27.4.0",
    "msw": "^2.12.7",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^4.0.18"
  }
}
