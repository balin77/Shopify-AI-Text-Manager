# Production Environment Variables Template
# Diese Datei dient als Template - NIEMALS committen mit echten Werten!
# In Railway setze diese Variables im Dashboard unter der "production" Environment

# Environment
NODE_ENV=production

# Shopify API Credentials (Production)
# Note: Shop name and access token come from database sessions (multi-tenant SaaS)
SHOPIFY_API_KEY=your-production-api-key-here
SHOPIFY_API_SECRET=your-production-api-secret-here
SHOPIFY_API_VERSION=2025-10
SHOPIFY_SCOPES=read_legal_policies,write_legal_policies,read_locales,read_online_store_navigation,write_online_store_navigation,read_online_store_pages,write_online_store_pages,read_product_listings,write_product_listings,read_products,write_products,read_content,write_content,read_themes,write_themes,read_translations,write_translations

# Shopify App URLs (Production - wird von Railway gesetzt)
# In Railway nutze: ${{RAILWAY_PUBLIC_DOMAIN}} oder deine Custom Domain
SHOPIFY_APP_URL=https://your-production-domain.railway.app

# AI Provider Configuration
AI_PROVIDER=claude

# AI Provider API Keys — NICHT als Shared-/Operator-Keys setzen!
# Compliance B4 (merchant-owned keys, Option A): Der Code liest diese Vars
# nicht; jeder Merchant trägt seinen eigenen Key in den App-Settings ein.
# Leer lassen — ein gesetzter Shared-Key hebelt die Compliance-Fix aus.
# Siehe docs/SECURITY_IMPROVEMENTS.md (Secret-Rotation Runbook R6).
HUGGINGFACE_API_KEY=
GOOGLE_API_KEY=

# Optional: Anthropic Claude API Key
ANTHROPIC_API_KEY=

# Optional: OpenAI API Key
OPENAI_API_KEY=

# Encryption Key for API Key Storage
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-production-encryption-key-64-chars

# Database URL (wird automatisch von Railway Postgres gesetzt)
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# Optional: Sentry/Monitoring
# SENTRY_DSN=your-sentry-dsn-for-production

# Optional: Rate Limiting
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW=15

# ── Test-billing allowlist (public production build) ─────────────────────────
# Comma-separated, developer-OWNED shop domains. For these shops the REAL
# Shopify billing flow runs completely unchanged (subscription object,
# webhooks, trial, proration, plan resolution) but appSubscriptionCreate uses
# test:true so no money is charged — for long-term billing edge-case testing
# on your own live store. Shopify stays the source of truth; this does NOT
# write the plan off-platform (no B1/B2 bypass). The dev-only 'override' mode
# is unreachable here: it requires the dev app's client_id, which Shopify
# enforces and the public binary never carries.
# MUST contain only shops you own. EMPTY for a normal release.
# DEV_PLAN_OVERRIDE_SHOPS=
