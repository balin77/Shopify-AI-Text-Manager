# Production Environment Variables Template
# Diese Datei dient als Template - NIEMALS committen mit echten Werten!
# In Railway setze diese Variables im Dashboard unter der "production" Environment

# Environment
NODE_ENV=production

# Shopify API Credentials (Production)
# Note: Shop name and access token come from database sessions (multi-tenant SaaS)
SHOPIFY_API_KEY=your-production-api-key-here
SHOPIFY_API_SECRET=your-production-api-secret-here
SHOPIFY_API_VERSION=2025-10
SHOPIFY_SCOPES=read_legal_policies,write_legal_policies,read_locales,read_online_store_navigation,write_online_store_navigation,read_online_store_pages,write_online_store_pages,read_product_listings,write_product_listings,read_products,write_products,read_content,write_content,read_themes,write_themes,read_translations,write_translations,read_files,write_files

# Shopify App URLs (Production - wird von Railway gesetzt)
# In Railway nutze: ${{RAILWAY_PUBLIC_DOMAIN}} oder deine Custom Domain
SHOPIFY_APP_URL=https://your-production-domain.railway.app

# AI-Provider-Keys der Merchants liegen in der DATENBANK, nicht hier.
#
# Die früher hier aufgeführten Namen (HUGGINGFACE_API_KEY, GOOGLE_API_KEY,
# ANTHROPIC_API_KEY, OPENAI_API_KEY) sind ENTFERNT statt leer gelassen: Compliance
# B4 nennt sie als Variablen, die nie gesetzt werden dürfen, und eine leere Zeile
# mit dem Kommentar "nicht setzen" ist genau die Einladung, die der Audit
# abschaffen wollte. Der Code liest keine davon.
#
# ── Managed AI (PLAN_MANAGED_AI_KEY) ──────────────────────────────────────────
# Der OPERATOR-Key für "KI inklusive". Gelesen von genau EINEM Modul,
# app/services/ai/ai-credentials.server.ts, das zugleich Einwilligung und Budget
# prüft — ein Key, den man nur zusammen mit seinem Gate bekommt, lässt sich nicht
# daran vorbei bekommen.
#
# Managed AI ist OPT-IN: ohne MANAGED_AI_ENABLED=true ist es aus, auch wenn ein
# Key konfiguriert ist. Im Dev-/Custom-App-Build wird der Key grundsätzlich nicht
# ausgeliefert (§7a).
MANAGED_AI_ENABLED=false
MANAGED_AI_PROVIDER=
MANAGED_AI_MODEL=
MANAGED_AI_API_KEY=

# Failover — anderer Anbieter, andere Statusseite (§3a). Fehlt er, läuft managed
# AI weiter; ein Ausfall des Default-Anbieters ist dann aber ein Ausfall.
MANAGED_AI_FALLBACK_PROVIDER=
MANAGED_AI_FALLBACK_MODEL=
MANAGED_AI_FALLBACK_API_KEY=

# Encryption Key for API Key Storage
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-production-encryption-key-64-chars

# Database URL (wird automatisch von Railway Postgres gesetzt)
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# ── Sentry error tracking ────────────────────────────────────────────────────
# HARD GATE: Sentry only runs when APP_ENV === "production" AND SENTRY_DSN is
# set. On any non-production environment (same code, different APP_ENV) every
# Sentry call is a complete no-op — zero events, even if a DSN is present here.
# Create the project in a Sentry EU organization for GDPR data residency
# (region is encoded in the DSN — no code flag needed).
APP_ENV=production
# SENTRY_DSN=https://...ingest.de.sentry.io/...   (EU region!)
#
# Free-tier defaults are conservative. To scale up after upgrading the Sentry
# plan, just set these env vars — no code change / no redeploy logic change:
# SENTRY_TRACES_SAMPLE_RATE=0      # 0 = no performance/tracing volume; e.g. 0.1
#   NOTE (review R4): this alone enables error tracking, but FULL performance
#   tracing/spans (OTel auto-instrumentation) additionally requires starting
#   node with `--import ./instrument.mjs`. Error tracking — the only goal of
#   this integration — works without it. Real tracing is a deliberate
#   non-goal of the free-tier setup: it needs a startup change, not just envs.
# SENTRY_CLIENT_SAMPLE_RATE=1.0    # browser error sampling; lower if volume grows
# SENTRY_ENVIRONMENT=production    # defaults to APP_ENV / NODE_ENV
# SENTRY_RELEASE=                  # defaults to RAILWAY_GIT_COMMIT_SHA
#
# Optional readable (de-minified) stack traces. Setting SENTRY_AUTH_TOKEN
# enables sourcemap upload at build time. Costs NO error quota. Without it the
# build is unchanged. Needs SENTRY_ORG + SENTRY_PROJECT too.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
#
# FREE-TIER SAFETY NET (no code/env — set in the Sentry dashboard):
# The code intentionally still reports heuristically-categorized 4xx generic
# errors (so real bugs are not hidden — see R3 note in sentry.server.ts), and
# client errors are sampled. To cap a runaway spike from blowing the shared
# 5k/month quota, enable in Sentry project Settings:
#   - Spike Protection (Settings → Spike Protection)        — free
#   - Inbound Filters + a per-key rate limit (Settings → Client Keys) — free
# This is the cheapest real backstop and is purely dashboard-side.

# Optional: Rate Limiting
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW=15

# ── Test-billing allowlist (public production build) ─────────────────────────
# Comma-separated, developer-OWNED shop domains. For these shops the REAL
# Shopify billing flow runs completely unchanged (subscription object,
# webhooks, trial, proration, plan resolution) but appSubscriptionCreate uses
# test:true so no money is charged — for long-term billing edge-case testing
# on your own live store. Shopify stays the source of truth; this does NOT
# write the plan off-platform (no B1/B2 bypass). The dev-only 'override' mode
# is unreachable here: it requires the dev app's client_id, which Shopify
# enforces and the public binary never carries.
# MUST contain only shops you own. EMPTY for a normal release.
# DEV_PLAN_OVERRIDE_SHOPS=
