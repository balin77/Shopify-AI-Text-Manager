# Development Environment Variables Template
# Diese Datei dient als Template - NIEMALS committen mit echten Werten!
# In Railway setze diese Variables im Dashboard unter der "development" Environment

# Environment
NODE_ENV=development

# ── Sentry error tracking ────────────────────────────────────────────────────
# Intentionally DISABLED in development. Sentry only runs when
# APP_ENV === "production" AND SENTRY_DSN is set. Leave APP_ENV unset (or any
# value other than "production") and Sentry stays a complete no-op here — the
# dev environment produces many expected errors that must NOT consume the
# shared free-tier quota. Do not set SENTRY_DSN in dev.
# APP_ENV=development
# SENTRY_DSN=

# Shopify API Credentials (Development)
# Note: Shop name and access token come from database sessions (multi-tenant SaaS)
# OPTION 1: Separate Dev App (empfohlen)
SHOPIFY_API_KEY=your-development-api-key-here
SHOPIFY_API_SECRET=your-development-api-secret-here
# OPTION 2: Gleiche App wie Production (einfacher aber weniger sauber)
# Nutze die gleichen Credentials wie Production
SHOPIFY_API_VERSION=2025-10
SHOPIFY_SCOPES=read_legal_policies,write_legal_policies,read_locales,read_online_store_navigation,write_online_store_navigation,read_online_store_pages,write_online_store_pages,read_product_listings,write_product_listings,read_products,write_products,read_content,write_content,read_themes,write_themes,read_translations,write_translations,read_files,write_files

# Shopify App URLs (Development - wird von Railway gesetzt)
# In Railway nutze: ${{RAILWAY_PUBLIC_DOMAIN}}
SHOPIFY_APP_URL=https://your-development-domain.railway.app

# AI-Provider-Keys der Merchants liegen in der DATENBANK, nicht hier.
#
# Die früher hier aufgeführten Namen (HUGGINGFACE_API_KEY, GOOGLE_API_KEY,
# ANTHROPIC_API_KEY, OPENAI_API_KEY) sind ENTFERNT statt leer gelassen: Compliance
# B4 nennt sie als Variablen, die nie gesetzt werden dürfen, und eine leere Zeile
# mit dem Kommentar "nicht setzen" ist genau die Einladung, die der Audit
# abschaffen wollte. Der Code liest keine davon.
#
# ── Managed AI (PLAN_MANAGED_AI_KEY) ──────────────────────────────────────────
# Der OPERATOR-Key für "KI inklusive". Gelesen von genau EINEM Modul,
# app/services/ai/ai-credentials.server.ts, das zugleich Einwilligung und Budget
# prüft — ein Key, den man nur zusammen mit seinem Gate bekommt, lässt sich nicht
# daran vorbei bekommen.
#
# Managed AI ist OPT-IN: ohne MANAGED_AI_ENABLED=true ist es aus, auch wenn ein
# Key konfiguriert ist. Im Dev-/Custom-App-Build wird der Key grundsätzlich nicht
# ausgeliefert (§7a).
MANAGED_AI_ENABLED=false
MANAGED_AI_PROVIDER=
MANAGED_AI_MODEL=
MANAGED_AI_API_KEY=

# Failover — anderer Anbieter, andere Statusseite (§3a). Fehlt er, läuft managed
# AI weiter; ein Ausfall des Default-Anbieters ist dann aber ein Ausfall.
MANAGED_AI_FALLBACK_PROVIDER=
MANAGED_AI_FALLBACK_MODEL=
MANAGED_AI_FALLBACK_API_KEY=

# Encryption Key for API Key Storage
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WICHTIG: Kann gleich wie Production sein ODER separate für mehr Isolation
ENCRYPTION_KEY=your-development-encryption-key-64-chars

# Database URL (wird automatisch von Railway Postgres Development DB gesetzt)
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# Development-specific: Verbose Logging
# DEBUG=true
# LOG_LEVEL=debug

# Optional: Disable rate limiting for development
# RATE_LIMIT_ENABLED=false

# ── Dev-Plan-Override (custom-app build) ─────────────────────────────────────
# This dev/custom build (SHOPIFY_API_KEY = 433cf493223c0c6b95bdb91b0de5961a +
# APP_ENV != 'production') has NO Shopify Billing API. The plan is read from
# AISettings.devForcedPlan and switched freely from the in-app plan UI; it
# persists across restarts. No extra env var needed to enable it here.
# DEV_PLAN_OVERRIDE_SHOPS is only consulted by the PUBLIC production build (it
# enables Shopify test-charges for your own shop there) — see
# .env.production.template. Set it here only if you also run the public build.
# DEV_PLAN_OVERRIDE_SHOPS=8c19f3-ce.myshopify.com
