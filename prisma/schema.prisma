generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
  lastActivityAt      DateTime? @default(now())
}

model AISettings {
  id                String  @id @default(cuid())
  shop              String  @unique
  huggingfaceApiKey String?
  geminiApiKey      String?
  claudeApiKey      String?
  openaiApiKey      String?
  grokApiKey        String?
  deepseekApiKey    String?
  preferredProvider String  @default("claude")
  selectedModel     String?
  appLanguage       String  @default("de")
  subscriptionPlan  String  @default("free") // "free", "basic", "pro", "max"

  // How to handle Shopify's richtext rule ("all top level nodes must be
  // <p>/<ul>/<ol>/<h1>-<h6>") when saving primary theme-settings values
  // (e.g. Brand information → brand_description). Merchant-selectable in Settings.
  //   "autofix"   (default) — try the save; if Shopify rejects for this reason,
  //               normalize the offending value's top-level HTML and retry once.
  //   "normalize" — always normalize HTML-bearing theme-settings values before
  //               pushing, no retry round-trip.
  //   "error"     — never rewrite merchant HTML; surface a clear instruction.
  themeRichtextMode String @default("autofix")

  // PLAN_CONTENT_CREATION §Phase 3.3 / §A1 — create a URL redirect when a
  // handle changes.
  //
  // Default ON, deliberately: changing a handle silently 404s every existing
  // link to the old address (search results, the merchant's own newsletter,
  // other sites), and this app changed handles in three places while creating
  // a redirect in none of them. A stray redirect is untidy; a broken URL costs
  // traffic. Off is for merchants still shaping their handles, where the
  // redirects would only be noise.
  seoAutoHandleRedirect Boolean @default(true)

  // Theme selected by the merchant for theme-bezogene Inhalte (Templates /
  // Theme-Settings / Locale-Content). Stored as the Shopify Theme-GID
  // ("gid://shopify/OnlineStoreTheme/<id>"). null = automatically use the
  // published (MAIN) theme — backwards compatible with the pre-selection
  // behaviour. Validated against GET_THEMES on every read
  // (resolveSelectedThemeId) so a deleted/deinstalled theme falls back to MAIN.
  selectedThemeId String?

  // Keep templates/llms.txt.liquid in step with the catalog automatically
  // (SEO → AI search, step 2). The background pass only ever UPDATES a file the
  // merchant already generated — it never creates one — and writes only when
  // the rebuilt content actually differs, so the default is on: an out-of-date
  // llms.txt is worse than no llms.txt. Also requires AEO_THEME_WRITES.
  llmsTxtAutoUpdate Boolean @default(true)

  // When the llms.txt auto-refresh last RAN for this shop (not when it last
  // wrote — a run that found no difference stamps this too). Drives the daily
  // shop-independent sweep in seo/llms-auto-refresh.service.ts: it makes the
  // sweep idempotent across replicas and restarts, and lets a shop refreshed
  // through the in-app path skip the sweep entirely.
  llmsTxtLastAutoRunAt DateTime?

  // Merchant-authored opening paragraph of the two AI-discovery files
  // (SEO → AI search, step 2). Everything else in those documents is generated
  // from the catalog and MUST stay generated — a hand-edited product list goes
  // stale the moment a price or a handle changes, and the auto-refresh would
  // overwrite it anyway. The intro is the one part no catalog query can know:
  // who is behind the shop, where it ships, what it wants an agent to say
  // about it. NULL means "use the generated default", which is what every shop
  // starts with.
  aiDiscoveryIntroAgents String?
  aiDiscoveryIntroLlms   String?

  // "Übersetzungen mitführen" on SEO → interne Verlinkung. Accepting a
  // suggestion only wraps an existing word in an <a>, so the wording is
  // unchanged and the primary save's stale-translation purge would throw away
  // hand-written translations for nothing. On (the default), the accept skips
  // that purge and writes the same link into every translation with its
  // localized URL; off restores the plain-save behaviour. Persisted per shop so
  // a merchant who deliberately turns it off does not get it back on the next
  // page load — see app/services/seo/internal-links-translate.server.ts.
  seoLinksCarryTranslations Boolean @default(true)

  // Dev/test affordance — read ONLY by the custom-app build. The custom-app
  // Shopify distribution has NO Billing API at all, so on that build the plan
  // is decoupled from Shopify and read from here instead. resolveDevPlanMode()
  // (app/services/dev-plan-override.server.ts) gates every read/write behind
  // the dev app's client_id (SHOPIFY_API_KEY) AND APP_ENV !== 'production', so
  // this column is provably never consulted by the public App-Store build.
  // null = no override (normal Shopify-derived plan).
  devForcedPlan String? // "free" | "basic" | "pro" | "max" | null

  // Persistent per-shop trial-consumption marker. Set ONCE when a trial-bearing
  // subscription is verified ACTIVE (never optimistically at the mutation call,
  // never reset — not even on cancel). Bewusste Entscheidung: das Feld liegt auf
  // AISettings (shop-scoped) und wird damit bei shop/redact mitgelöscht. Das ist
  // gewollt — ein vollständig redacteter Shop, der echt neu installiert, darf
  // wieder einen Trial bekommen. Der Missbrauchspfad
  // (free → basic[Trial] → cancel → pro OHNE Uninstall/Redact) wird geschlossen,
  // weil die Zeile dabei erhalten bleibt. null = Trial noch nie konsumiert.
  trialConsumedAt DateTime?

  // One-shot marker: set the first time a Pro/Max shop is shown the
  // theme-extension setup hint (infobox on app start). Without it the hint
  // would re-appear on every load. Like trialConsumedAt this lives on the
  // shop-scoped AISettings row, so it is cleared on shop/redact — a freshly
  // reinstalled Pro/Max shop may legitimately see the hint again.
  // null = hint not yet shown.
  extensionSetupHintShownAt DateTime?

  // Rate Limiting - Hugging Face
  hfMaxTokensPerMinute   Int? @default(1000000)
  hfMaxRequestsPerMinute Int? @default(100)

  // Rate Limiting - Gemini
  geminiMaxTokensPerMinute   Int? @default(1000000)
  geminiMaxRequestsPerMinute Int? @default(15)

  // Rate Limiting - Claude
  claudeMaxTokensPerMinute   Int? @default(40000)
  claudeMaxRequestsPerMinute Int? @default(5)

  // Rate Limiting - OpenAI
  openaiMaxTokensPerMinute   Int? @default(200000)
  openaiMaxRequestsPerMinute Int? @default(500)

  // Rate Limiting - Grok
  grokMaxTokensPerMinute   Int? @default(100000)
  grokMaxRequestsPerMinute Int? @default(60)

  // Rate Limiting - DeepSeek
  deepseekMaxTokensPerMinute   Int? @default(100000)
  deepseekMaxRequestsPerMinute Int? @default(60)

  // SEO Title suffix (shop name appended by Shopify theme)
  seoTitleSuffixEnabled Boolean   @default(false)
  seoTitleSuffix        String? // e.g., " – Patis Universe"
  // Merchant switch for the nightly audit (Settings → SEO). Default ON so an
  // entitled shop gets the trend without hunting for a checkbox; the sweep
  // filters on it IN THE QUERY, so switching it off costs nothing per tick.
  // Independent of the plan gate: both must hold for a scan to happen.
  seoAutoAuditEnabled   Boolean   @default(true)
  // Last automatic (nightly) SEO audit run for this shop — see
  // services/seo/audit-auto-run.service.ts. Null = never auto-scanned. Drives
  // the sweep's "is this shop due" query and is stamped on every path
  // (success, skip, error) so a broken shop cannot win it forever. Backoff
  // stamp, NOT a lock. Only shops on a plan with seo.scheduledAudit are ever
  // selected.
  lastAutoAuditAt       DateTime?

  // PLAN_SEO_CRAWL_EXPANSION §6.5 — check outbound links to OTHER domains
  // after the storefront crawl. Default ON (the report is worth little
  // without it), but switchable: it is the only part of this app that sends
  // requests to servers neither the merchant nor we control, and it makes the
  // crawl take longer.
  seoCrawlExternalLinks Boolean @default(true)

  // Merchant switch for the weekly automatic storefront crawl (Settings → SEO).
  // Default ON for the same reason as seoAutoAuditEnabled — an entitled shop
  // should get the delivery report without hunting for a checkbox — and ANDed
  // into the sweep's due-query, so switching it off costs nothing per tick.
  seoAutoCrawlEnabled Boolean   @default(true)
  // Last automatic storefront crawl for this shop — see
  // services/seo/crawl-auto-run.service.ts. Null = never auto-crawled. Same
  // backoff-stamp rules as lastAutoAuditAt: written on every path, never a
  // lock, and only shops on a plan with seo.scheduledCrawl are selected.
  // Separate from lastAutoAuditAt on purpose: the two sweeps run at different
  // cadences (daily audit vs weekly crawl) and one stamp cannot express both.
  lastAutoCrawlAt     DateTime?

  // Keyword-aware translation: a translation into a foreign locale is
  // phrased so THAT locale's own tracked keyword survives, instead of being
  // a literal rendering of the primary text. Default on — it is what a
  // merchant who bothered to track per-language keywords expects; the flag
  // exists for shops whose translations must stay strictly faithful
  // (legal copy, regulated product text).
  keywordAwareTranslation Boolean @default(true)

  // Stale-translation purge switch ("Übersetzungen bei Änderung löschen").
  // When a PRIMARY value changes (or is cleared), its foreign translations no
  // longer describe the source text, so every write path in this app removes
  // them on Shopify AND locally. That is the historic, hard-coded behaviour —
  // this column makes it a merchant decision. Default TRUE = unchanged
  // behaviour; FALSE keeps the old translations in place (Shopify then shows
  // them flagged "outdated" in its own translation editor).
  // Read through services/translations/translation-change-policy.server.ts,
  // which fails OPEN (true) so a lookup error can never silently start
  // preserving stale translations.
  translationPurgeOnPrimaryChange Boolean @default(true)

  // Max plan: when a primary text changes OUTSIDE this app (Shopify admin,
  // another app, an import) and the sync sees Shopify's `outdated` flag, do
  // not just delete the now-stale translation — re-translate the NEW primary
  // value into that locale right away. Off by default: it spends the
  // merchant's AI budget without them being present. Plan-gated to "max" at
  // every read (the column may hold `true` from a period on a higher plan).
  autoTranslateExternalChanges Boolean @default(false)

  // Translation length policy. "exact" (default) preserves source length —
  // legal/rechts pages must not shrink. "seo_optimized" appends per-field
  // character constraints to the translate prompt for SEO-critical fields
  // (title, seoTitle, metaDescription, altText), so a long German meta title
  // gets paraphrased to fit the 60-char SEO limit instead of overflowing.
  translationMode String @default("exact") // "exact" | "seo_optimized"

  // Merchant-editable SEO character limits (Pro+). null = fall back to the
  // built-in defaults in app/utils/character-limits.ts. Shape (all optional):
  //   { titleMin, titleMax, seoTitleMax, metaDescMin, metaDescMax,
  //     handleMin, handleMax, altTextMin, altTextMax, descriptionMin }
  // Consumed by getCharacterLimitRequirement() to build the length hint in AI
  // prompts, and by the seo-optimized translation mode above.
  seoLimits Json?

  // Metafields settings tab: timestamp of the last product metafield-definition
  // scan. Also doubles as the lazy-backfill guard — when null, the loaders run
  // a one-time backfill of already-translatable definitions into
  // EnabledMetafieldDefinition so existing merchants' editors stay populated.
  metafieldsLastScanAt DateTime?

  // Content-Freshness audit (PLAN_SEO_SUITE_COMPLETION.md §5.3/§5.5): the
  // merchant's "Ignorieren" list for refresh candidates. Deliberately NOT a
  // separate Prisma model — the plan leaves the store open ("bei Umsetzung
  // entscheiden") and a dismissed-set has no history/reporting need of its
  // own, so it rides along on the per-shop settings row that already exists
  // and is already purged on shop/redact (no separate GDPR entry needed).
  // JSON array of "<resourceType>:<resourceId>" strings, e.g.
  // ["Product:gid://shopify/Product/123"]. null/absent = nothing dismissed.
  seoFreshnessDismissed Json?

  /// UNUSED. Backed an in-app banner explaining the Phase 4 re-consent, which
  /// was removed as unwanted. Kept because its migration may already be
  /// applied, and a drop-migration for a column that might not exist is the
  /// riskier error than a dead nullable one. Safe to drop deliberately.
  commerceNoticeDismissedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Backs the nightly-audit sweep's due-query (audit-auto-run.service.ts).
  @@index([subscriptionPlan, lastAutoAuditAt])
  // Same, for the weekly crawl sweep (crawl-auto-run.service.ts).
  @@index([subscriptionPlan, lastAutoCrawlAt])
}

// Product metafield definitions a merchant has explicitly enabled for the
// ContentPilot translation pipeline (Metafields settings tab). A metafield is
// shown/translated in the product editor only when its definition is BOTH
// translatable AND present here (decided design point 1). Removing a row hides
// the field from the editor again WITHOUT reverting the Shopify-side storefront
// access change (that would be destructive for the storefront/other tools).
model EnabledMetafieldDefinition {
  id                  String   @id @default(cuid())
  shop                String
  // Shopify GID of the MetafieldDefinition.
  definitionId        String
  namespace           String
  key                 String
  // "PRODUCT" for now — column exists so later owner types can reuse the model.
  ownerType           String   @default("PRODUCT")
  // True when ContentPilot had to set the definition's storefront access to
  // PUBLIC_READ to make it translatable (i.e. it was not publicly accessible and
  // shop-owned). False for definitions that were already translatable/public
  // (incl. backfilled ones).
  patchedTranslatable Boolean  @default(false)
  enabledAt           DateTime @default(now())

  @@unique([shop, definitionId])
  @@index([shop, ownerType])
}

// Direct translations ("Direktübersetzungen"): merchant-managed storefront text
// that is NOT in translatable Shopify fields (e.g. third-party app widgets:
// review widgets, badges, page builders). A theme app embed replaces this text
// client-side using a merchant-curated dictionary. A first-class content type in
// the admin (consistent with products/collections/templates).
//
// An item is the IDENTITY (one rendered source string); its translations hang
// off it by FK (not by text), so editing the source text keeps the translations.
// Matching is exact on the normalized source — no fuzzy/partial matching.
// SEO caveat: client-side DOM replacement is not server-rendered.
model DirectTranslationItem {
  id         String   @id @default(cuid())
  shop       String
  // Stable hash of the normalized source string — identity of the item. The
  // storefront and admin both normalize identically so lookups are O(1).
  sourceHash String
  sourceText String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  translations DirectTranslation[]

  @@unique([shop, sourceHash])
  @@index([shop])
}

// One translation of a DirectTranslationItem into one locale. Cascade-deleted
// with its item; the source attaches translations by item FK, never by text.
model DirectTranslation {
  id         String                @id @default(cuid())
  itemId     String
  item       DirectTranslationItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  locale     String // target language ISO, e.g. "fr"
  targetText String                @db.Text
  // "user" (manually entered / transferred) or "ai" (auto-translated).
  source     String                @default("user")
  updatedAt  DateTime              @updatedAt

  // Market dimension — see ContentTranslation.marketId. "" = global.
  marketId String @default("")

  @@unique([itemId, locale, marketId])
}

// Untranslated strings discovered on the storefront (opt-in collector), pending
// merchant review. "Hinzufügen" promotes one to a DirectTranslationItem (and
// deletes the candidate); "Ablehnen" sets status `rejected` (kept, but never
// re-raises a notification). Strings that already exist as items are skipped.
model DirectTranslationCandidate {
  id          String   @id @default(cuid())
  shop        String
  sourceHash  String
  sourceText  String   @db.Text
  count       Int      @default(1) // times seen across visitors/pages
  status      String   @default("new") // "new" | "rejected"
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([shop, sourceHash])
  @@index([shop, status])
  // Backs the FIFO-prune query (delete oldest when a shop's candidate count
  // exceeds MAX_CANDIDATES_PER_SHOP). Without this Postgres falls back to a
  // table scan + sort once a shop accumulates a few hundred candidates.
  @@index([shop, lastSeenAt])
}

// Per-shop settings + cache-busting version for the direct translation layer.
// NOTE: `enabled` is gone — the theme app embed is the on/off switch. Scope is
// gone — direct translations are global (apply on all pages).
model DirectTranslationSettings {
  shop              String   @id
  // Opt-in: when true, the storefront reports untranslated strings it renders
  // (heuristically filtered, capped) so the merchant can review them in the
  // admin. Off by default (privacy/noise). Never auto-applied.
  collect           Boolean  @default(false)
  // Opt-in: when true, the storefront walks AND replaces text even inside
  // elements marked `translate="no"`. 3rd-party review/widget apps (Judge.me
  // etc.) set that attribute to fence off browser auto-translate; for direct
  // translations the merchant is in control and usually wants those reached.
  ignoreTranslateNo Boolean  @default(false)
  // Opt-in: when true, server-side language detection (franc) drops collected
  // candidates whose language matches the locale they were reported from —
  // i.e. strings that the storefront already serves in the right language and
  // therefore don't need a direct translation.
  filterByLanguage  Boolean  @default(false)
  // Bumped on every dictionary change so the storefront cache invalidates.
  version           Int      @default(1)
  updatedAt         DateTime @updatedAt
}

model AIInstructions {
  id   String @id @default(cuid())
  shop String @unique

  // GENERAL - Writing Style Instructions (used by all AI generate/improve operations)
  writingStyleInstructions   String? @db.Text
  // GENERAL - Format Instructions (used by the "Format" function)
  formatPreserveInstructions String? @db.Text
  // GENERAL - Translate Instructions (used by the "Translate" function)
  translateInstructions      String? @db.Text

  // PRODUCTS - All fields available
  productTitleFormat             String? @db.Text
  productTitleInstructions       String? @db.Text
  productDescriptionFormat       String? @db.Text
  productDescriptionInstructions String? @db.Text
  productHandleFormat            String? @db.Text
  productHandleInstructions      String? @db.Text
  productSeoTitleFormat          String? @db.Text
  productSeoTitleInstructions    String? @db.Text
  productMetaDescFormat          String? @db.Text
  productMetaDescInstructions    String? @db.Text
  productAltTextFormat           String? @db.Text
  productAltTextInstructions     String? @db.Text

  // COLLECTIONS - All fields except altText
  collectionTitleFormat             String? @db.Text
  collectionTitleInstructions       String? @db.Text
  collectionDescriptionFormat       String? @db.Text
  collectionDescriptionInstructions String? @db.Text
  collectionHandleFormat            String? @db.Text
  collectionHandleInstructions      String? @db.Text
  collectionSeoTitleFormat          String? @db.Text
  collectionSeoTitleInstructions    String? @db.Text
  collectionMetaDescFormat          String? @db.Text
  collectionMetaDescInstructions    String? @db.Text

  // BLOGS/ARTICLES - All fields except altText
  blogTitleFormat             String? @db.Text
  blogTitleInstructions       String? @db.Text
  blogDescriptionFormat       String? @db.Text
  blogDescriptionInstructions String? @db.Text
  blogHandleFormat            String? @db.Text
  blogHandleInstructions      String? @db.Text
  blogSeoTitleFormat          String? @db.Text
  blogSeoTitleInstructions    String? @db.Text
  blogMetaDescFormat          String? @db.Text
  blogMetaDescInstructions    String? @db.Text

  // PAGES - Title, Description (body), Handle only (no SEO fields)
  pageTitleFormat             String? @db.Text
  pageTitleInstructions       String? @db.Text
  pageDescriptionFormat       String? @db.Text
  pageDescriptionInstructions String? @db.Text
  pageHandleFormat            String? @db.Text
  pageHandleInstructions      String? @db.Text
  pageSeoTitleFormat          String? @db.Text
  pageSeoTitleInstructions    String? @db.Text
  pageMetaDescFormat          String? @db.Text
  pageMetaDescInstructions    String? @db.Text

  // POLICIES - Only body/description is editable
  policyDescriptionFormat       String? @db.Text
  policyDescriptionInstructions String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id            String  @id @default(cuid())
  shop          String
  type          String // "translation", "aiGeneration", "bulkTranslation", "bulkAiGeneration"
  status        String  @default("pending") // "pending", "queued", "running", "completed", "failed", "cancelled"
  resourceType  String? // "product", "collection", "blog", "page"
  resourceId    String? // Shopify GID
  resourceTitle String? // For display purposes
  fieldType     String? // "title", "description", "handle", "seoTitle", "metaDescription", "all"
  targetLocale  String? // For translations
  progress      Int     @default(0) // 0-100
  total         Int? // Total number of items (for bulk operations)
  processed     Int     @default(0) // Number of processed items
  prompt        String? @db.Text // The AI prompt/request sent
  result        String? @db.Text // JSON string with results or error message
  error         String? @db.Text

  // Queue management
  queuePosition   Int? // Position in queue (null if not queued)
  retryCount      Int     @default(0) // Number of retries attempted
  estimatedTokens Int? // Estimated tokens for this task
  provider        String? // AI provider used (huggingface, gemini, claude, openai, grok, deepseek) - for recovery
  aiModel         String? // AI model name used (e.g., gpt-4o, claude-3-5-sonnet-20241022)

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  expiresAt   DateTime? // Automatic deletion timestamp (set to createdAt + 3 days)

  @@index([shop, status])
  @@index([shop, createdAt])
  @@index([shop, queuePosition])
  @@index([expiresAt])
  // R3-H5: /api/recently-completed-tasks polls every ~2s per open admin tab
  // with WHERE shop=? AND status IN(..) AND completedAt>=? ORDER BY
  // completedAt DESC. [shop,status] doesn't cover the completedAt range/sort,
  // forcing a range scan that does not scale to thousands of shops.
  @@index([shop, status, completedAt])
}

model Product {
  id               String  @id // Shopify GID (e.g., "gid://shopify/Product/123")
  shop             String
  title            String
  descriptionHtml  String? @db.Text
  handle           String
  // Shopify ProductStatus, stored verbatim as the sync receives it (no
  // normalization). FOUR values occur in real data, not three: "ACTIVE",
  // "DRAFT", "UNLISTED", "ARCHIVED". UNLISTED means "active but reachable only
  // by direct link" — it exists from API 2025-10 on and DOES appear in
  // production caches. Code that enumerates statuses must handle it; assuming
  // three is what made unlisted products invisible to several SEO features.
  status           String
  productType      String? // Product type for categorization (e.g., "T-Shirt", "Shoes")
  seoTitle         String?
  seoDescription   String? @db.Text
  featuredImageUrl String?
  featuredImageAlt String?

  // Bulk editor Phase 3 (Plan §5.1): true when the product has MORE variants
  // than the sync's variants(first: 100) window fetched. Stored as an explicit
  // flag (from pageInfo.hasNextPage) instead of being derived from
  // "variant count === 100" — a product can legitimately have exactly 100
  // variants, so the derived form would be ambiguous. The UI shows a hint
  // that the remainder lives in the Shopify admin; the full sync deliberately
  // does NOT paginate variants (§5.1).
  hasMoreVariants Boolean @default(false)

  // Mirror of the product-video upload dates this app last wrote to the
  // `custom.video_upload_dates` metafield (services/seo/video-schema.*).
  // Liquid cannot know when a video was uploaded, and `uploadDate` is one of
  // Google's required VideoObject properties — so the sync carries the Admin
  // API's `File.createdAt` into a metafield the storefront block reads back.
  // This column exists to make that write DIFF-driven: null means "nothing
  // written / no videos", and a value equal to the freshly built one means no
  // Shopify call at all. It mirrors what was PUSHED (and echoed), never what
  // was merely intended.
  videoSchemaJson String? @db.Text

  // ── PLAN_CONTENT_CREATION Phase 0 — merchandising attributes ──────────────
  // Everything below is fetched by the product sync from Phase 0 on. Rows
  // written by an OLDER sync carry the column defaults, which for `vendor`
  // (null), `tags` ([]) and `isSmart`-style booleans is INDISTINGUISHABLE from
  // "the merchant left it empty" — the same trap as SeoCrawlPage.metaRobots.
  // `attributesSyncedAt` is the discriminator and the ONLY thing that tells
  // them apart: null ⇒ every column in this block is UNKNOWN, not "missing".
  // The attribute sidebar (§Phase 2) must gate on it before it shows a red dot.
  vendor             String?
  // Shopify product tags, verbatim and in Shopify's order. A scalar list can
  // never be null in Prisma, so [] alone says nothing — read it together with
  // `attributesSyncedAt`. The explicit @default([]) is what the migration's
  // `DEFAULT ARRAY[]::TEXT[]` needs to be declared as, or `migrate diff` reports
  // permanent drift against every deployed database.
  tags               String[]  @default([])
  // Shopify's product taxonomy. `categoryName` mirrors `fullName`
  // ("Apparel & Accessories > Clothing"), so the UI can label the category
  // without a second lookup.
  categoryId         String?
  categoryName       String?
  templateSuffix     String?
  publishedAt        DateTime?
  // Collection membership window of the sync: true when the product belongs to
  // MORE collections than `collections(first: N)` fetched. Same reason as
  // hasMoreVariants — "N memberships" must not read as complete when it is a
  // truncation.
  hasMoreCollections Boolean   @default(false)
  attributesSyncedAt DateTime?

  // Shopify Metadata
  shopifyUpdatedAt DateTime
  lastSyncedAt     DateTime @default(now())

  // Relations
  // NOTE: Translations are now stored in ContentTranslation table (polymorphic)
  images       ProductImage[]
  options      ProductOption[]
  metafields   ProductMetafield[]
  variants     ProductVariant[]
  collections  ProductCollection[]
  publications ProductPublication[]

  @@unique([shop, id])
  @@index([shop])
  @@index([shop, status])
  @@index([lastSyncedAt])
}

/// Collection membership of a product (PLAN_CONTENT_CREATION Phase 0).
///
/// Deliberately NOT a foreign key to `Collection`: the collection cache is
/// capped by the merchant's plan (`maxCollections`), so a membership can point
/// at a collection this shop never cached. `collectionTitle` is mirrored for
/// exactly that case — without it a capped-out membership would render as a
/// bare GID. Rows are rebuilt per product on every sync (delete-by-product +
/// createMany), so they never accumulate.
model ProductCollection {
  id        String  @id @default(cuid())
  shop      String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  collectionId    String
  collectionTitle String

  // True for a collection whose membership is rule-based on Shopify's side —
  // Phase 3's membership picker must not offer to "remove" such a row, the
  // rule would just re-add it.
  automated Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([productId, collectionId])
  @@index([productId])
  @@index([shop, collectionId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url                 String
  altText             String? // Primary locale alt-text
  mediaId             String? // Shopify Media ID (gid://shopify/MediaImage/123) for translations
  position            Int?
  altTextModifiedAt   DateTime? // Timestamp when user last modified alt-text (prevents webhook sync overwrite)
  altTextTranslations ProductImageAltTranslation[]

  // Atomic get-or-create keyed on (productId, mediaId) — prevents duplicate
  // ProductImage rows from concurrent alt-text applies. Postgres treats NULL
  // mediaId as distinct, so legacy rows without a Shopify media GID are unaffected.
  //
  // R4-H6 (assessed; intentionally NOT changed):
  //  • NULL-mediaId gap: NULL-distinctness is SQL-standard. It is acceptable
  //    here because every current write path (product sync, WebP, alt-text
  //    apply) always sets mediaId from a Shopify MediaImage GID — no path
  //    creates NULL-mediaId rows at volume; the only NULL rows are intentional
  //    legacy data. Closing the gap would require Postgres-15
  //    `NULLS NOT DISTINCT`, which could fail the migration on pre-existing
  //    duplicate-NULL rows and change semantics — disproportionate/uncertain.
  //  • non-CONCURRENT build: the backing migration
  //    (20260519100000_…) uses CREATE UNIQUE INDEX, which takes ACCESS
  //    EXCLUSIVE during the build. Prisma runs migrations in a transaction so
  //    CREATE INDEX CONCURRENTLY is not usable there. That migration is
  //    already applied (immutable history — must not be rewritten); on fresh
  //    DBs it builds on an empty table. FORWARD RULE: any future index on a
  //    large hot table must be added out-of-band CONCURRENTLY, not via an
  //    in-transaction Prisma migration, to avoid blocking boot/deploy.
  @@unique([productId, mediaId])
  @@index([productId])
}

model ProductImageAltTranslation {
  id      String       @id @default(cuid())
  imageId String
  image   ProductImage @relation(fields: [imageId], references: [id], onDelete: Cascade)

  locale  String // "en", "fr", "es", "it", etc.
  altText String @db.Text

  // Market dimension — see ContentTranslation.marketId. "" = global.
  marketId String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([imageId, locale, marketId])
  @@index([imageId])
  @@index([locale])
}

model ProductOption {
  id        String  @id // Shopify Option ID
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name               String
  position           Int
  values             String  @db.Text // JSON array
  linkedMetafieldKey String? // Metaobject type key when option is linked (e.g. "color")

  @@index([productId])
}

model ProductMetafield {
  id        String  @id // Shopify Metafield ID
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  namespace String
  key       String
  value     String @db.Text
  type      String

  @@index([productId])
}

model ProductVariant {
  id          String   @id // numerische Shopify ID
  shopifyGid  String   @unique // gid://shopify/ProductVariant/...
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  title       String
  sku         String?
  imageKey    String?
  position    Int
  galleryJson String?  @db.Text // JSON: ["gid://shopify/File/...", ...]
  updatedAt   DateTime @updatedAt

  // Bulk editor Phase 3 (Plan §5.2): pricing mirror from the regular product
  // sync. Decimal, not Float — money as Float is a rounding error waiting to
  // happen. Shopify's Money strings are converted in exactly ONE place
  // (moneyToDecimalString, product-variant-sync.server.ts).
  price          Decimal? @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  barcode        String?

  // ── PLAN_CONTENT_CREATION Phase 4 — the commerce block ────────────────────
  //
  // `inventoryItemId` is the KEY to all of it: quantities, cost and the
  // shipping fields live on InventoryItem, not on the variant, and every write
  // below addresses that GID. A variant without one cannot have its stock
  // edited — which is a fact to SHOW, not to guess around.
  inventoryItemId      String?
  // Cost per item (`InventoryItem.unitCost`). Decimal for the same reason
  // `price` is: money as Float is a rounding error waiting to happen.
  cost                 Decimal?  @db.Decimal(12, 2)
  // These four are `InventoryItem` fields, not variant fields. Nullable
  // because "not fetched" and "the merchant left it empty" must stay
  // distinguishable — `commerceSyncedAt` is the discriminator.
  taxable              Boolean?
  requiresShipping     Boolean?
  weight               Decimal?  @db.Decimal(12, 3)
  weightUnit           String?
  harmonizedSystemCode String?
  countryCodeOfOrigin  String?
  // `tracked` on InventoryItem; `inventoryPolicy` on the variant. Together
  // they decide whether a quantity means anything at all — an untracked
  // variant has no stock to show, and showing 0 for one is a lie.
  inventoryTracked     Boolean?
  inventoryPolicy      String?
  /// THE discriminator for the block above (same rule as
  /// `Product.attributesSyncedAt`): unset ⇒ every field in it is UNKNOWN, not
  /// "empty". Without it a variant row written by an older sync would report
  /// cost 0, untaxed and untracked — confident and wrong.
  commerceSyncedAt     DateTime?

  inventoryLevels InventoryLevel[]

  @@index([productId])
}

/// A location that can hold stock (PLAN_CONTENT_CREATION Phase 4).
///
/// Cached for LABELS and ordering only. Stock itself is volatile and the truth
/// is always Shopify's — this table exists so the inventory UI can say
/// "Warehouse Berlin" instead of a GID, and so the location list survives a
/// throttled lookup.
model Location {
  id       String  @id // gid://shopify/Location/...
  shop     String
  name     String
  /// A deactivated location keeps its stock but accepts no writes. Shown
  /// greyed rather than hidden: its quantity is still part of the total, and a
  /// location that silently vanishes reads as stock that disappeared.
  isActive Boolean @default(true)
  /// Shopify's own primary/fulfilment ordering, mirrored so the UI does not
  /// have to invent one.
  position Int     @default(0)

  syncedAt DateTime @default(now())

  levels InventoryLevel[]

  @@unique([shop, id])
  @@index([shop])
}

/// On-hand and available stock of ONE variant at ONE location.
///
/// ── This cache is a DISPLAY, never a base for arithmetic ────────────────────
/// Stock changes from orders, returns and other apps between two page loads.
/// Computing `new = cached + delta` and writing that back is the classic
/// source of inventory drift, and it is why the write path uses
/// `inventorySetQuantities` with an ABSOLUTE value and a compareQuantity —
/// never a delta over anything stored here.
model InventoryLevel {
  id              String         @id @default(cuid())
  shop            String
  /// gid://shopify/InventoryItem/... — the address every write uses.
  inventoryItemId String
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  locationId      String
  location        Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)

  /// Physically present. The number a merchant counts in the room.
  onHand    Int?
  /// On hand minus what is committed to unfulfilled orders. The number a
  /// storefront sells against. Both nullable: an untracked item reports
  /// neither, and 0 would be a different claim.
  available Int?

  syncedAt DateTime @default(now())

  @@unique([variantId, locationId])
  @@index([shop])
  @@index([inventoryItemId])
}

/// A sales channel a product is published to (PLAN_CONTENT_CREATION Phase 4).
///
/// §2.3's trap made concrete: `status: ACTIVE` is NOT visibility. A product
/// that is active but published to no channel is invisible everywhere, and
/// nothing in the Shopify admin says so on the product page either. This table
/// is what lets the editor say it.
model ProductPublication {
  id        String  @id @default(cuid())
  shop      String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// gid://shopify/Publication/...
  publicationId   String
  /// Mirrored so a publication the shop later loses still renders as a name.
  publicationName String
  /// Which KIND of catalog this publication belongs to: "app" (a sales
  /// channel), "market" (a region), "companyLocation" (B2B) — or "" for
  /// UNKNOWN, which is what a row written before this column existed and a
  /// publication whose catalog Shopify did not deliver both carry. Unknown is
  /// never read as "app": it renders where it always did, but it is not
  /// evidence for the "on no channel — invisible" alarm.
  catalogType     String    @default("")
  /// Published AND its publish date has passed. A future date is `false` with
  /// `publishDate` set — "scheduled" is not "live", and collapsing the two
  /// makes a scheduled launch look like a mistake.
  isPublished     Boolean   @default(false)
  publishDate     DateTime?

  syncedAt DateTime @default(now())

  @@unique([productId, publicationId])
  @@index([shop])
}

model OptionValueMemory {
  id          String   @id @default(cuid())
  shop        String
  optionValue String // original display name, e.g. "Erdnuss"
  savedAs     String // last saved key segment, e.g. "Peanut"
  updatedAt   DateTime @updatedAt

  @@unique([shop, optionValue])
  @@index([shop])
}

// Shop-weites Mapping fuer Felder mit Gruppierungs-Charakter (productType, perspektivisch vendor/tag).
// Mehrere Produkte mit demselben Quellwert muessen pro Zielsprache exakt eine gemeinsame Uebersetzung
// haben, sonst zerfaellt eine Kategorie in Google Merchant in mehrere.
model GroupedFieldTranslation {
  id              String   @id @default(cuid())
  shop            String
  fieldKey        String // "productType" (zukuenftig: "vendor" | "tag")
  sourceLocale    String
  sourceValueNorm String // trim + collapsed whitespace + lowercase (Lookup-Key)
  sourceValue     String // kanonische Originalform (Casing des ersten Inserts)
  targetLocale    String
  translatedValue String
  source          String   @default("ai") // "ai" | "user" | "imported"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([shop, fieldKey, sourceLocale, sourceValueNorm, targetLocale])
  @@index([shop, fieldKey, sourceLocale])
}

model ImageManagerSettings {
  id            String   @id @default(cuid())
  shopId        String   @unique
  enabled       Boolean  @default(true)
  firstImageBig Boolean  @default(false)
  showAltTags   Boolean  @default(false)
  autoAltText   Boolean  @default(false)
  thumbSize     Int      @default(80)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WebhookLog {
  id        String   @id @default(cuid())
  shop      String
  topic     String // "products/create", "products/update", "products/delete"
  productId String?
  payload   String   @db.Text // Full webhook payload
  processed Boolean  @default(false)
  error     String?  @db.Text
  createdAt DateTime @default(now())

  @@index([shop, topic])
  @@index([processed])
  @@index([createdAt])
}

model WebhookRetry {
  id          String   @id @default(cuid())
  shop        String
  topic       String // Webhook topic (e.g., "products/update")
  payload     String   @db.Text // Full webhook payload as JSON
  attempt     Int      @default(0) // Current retry attempt number
  maxAttempts Int      @default(5) // Maximum retry attempts
  nextRetry   DateTime // When to attempt next retry
  lastError   String?  @db.Text // Last error message
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([shop])
  @@index([nextRetry])
  @@index([attempt])
}

// ============================================
// CONTENT MODELS (Collections, Blogs, Pages)
// ============================================

model Collection {
  id              String  @id // Shopify GID (e.g., "gid://shopify/Collection/123")
  shop            String
  title           String
  descriptionHtml String? @db.Text
  handle          String
  imageUrl        String? // Collection image URL
  imageAltText    String? // Collection image alt text
  seoTitle        String?
  seoDescription  String? @db.Text

  // ── PLAN_CONTENT_CREATION Phase 0 ────────────────────────────────────────
  // Read `attributesSyncedAt` before any of these — see Product for why.
  sortOrder      String? // Shopify CollectionSortOrder, verbatim (e.g. "BEST_SELLING")
  templateSuffix String?
  // True when membership is rule-based rather than hand-picked. Derived from
  // whatever the pinned API version exposes (2025-10: `ruleSet`; 2026-07 on:
  // a non-empty `sources[]`), never from a client claim.
  isSmart        Boolean @default(false)
  /// The FULL rule tree, never flattened (PLAN §2.4): the editor must be able
  /// to hand back structures it cannot render instead of silently simplifying
  /// them, which would change a collection's membership unnoticed.
  ///
  /// Stored as a DISCRIMINATED envelope, because the shape depends on the API
  /// version the sync ran against and the two are not interchangeable:
  ///   { "shape": "ruleSet", "apiVersion": "2025-10", "data": { … } }
  ///   { "shape": "sources", "apiVersion": "2026-07", "data": [ … ] }
  /// A bare tree would leave a reader guessing which model it is looking at —
  /// exactly the "empty column is never evidence" trap. null = never synced.
  sourcesJson    Json?

  attributesSyncedAt DateTime?

  // Shopify Metadata
  shopifyUpdatedAt DateTime
  lastSyncedAt     DateTime @default(now())

  @@unique([shop, id])
  @@index([shop])
  @@index([lastSyncedAt])
}

model Article {
  id             String  @id // Shopify GID (e.g., "gid://shopify/Article/123")
  shop           String
  blogId         String // Shopify Blog GID
  blogTitle      String // For display purposes
  title          String
  body           String? @db.Text
  summary        String? @db.Text // Article excerpt/summary
  handle         String
  imageUrl       String? // Featured image URL
  imageAltText   String? // Featured image alt text
  seoTitle       String?
  seoDescription String? @db.Text

  // ── PLAN_CONTENT_CREATION Phase 0 ────────────────────────────────────────
  // Read `attributesSyncedAt` before any of these — see Product for why.
  // `author` is the one field here that is not merely a gap: ArticleCreateInput
  // requires it, so article creation is impossible without it (§1.4).
  author         String?
  tags           String[]  @default([]) // see Product.tags for why the default is explicit
  templateSuffix String?
  isPublished    Boolean   @default(true)
  publishedAt    DateTime?

  attributesSyncedAt DateTime?

  // Shopify Metadata
  shopifyUpdatedAt DateTime
  lastSyncedAt     DateTime @default(now())

  @@unique([shop, id])
  @@index([shop])
  @@index([shop, blogId])
  @@index([lastSyncedAt])
}

model Page {
  id     String  @id // Shopify GID (e.g., "gid://shopify/Page/123")
  shop   String
  title  String
  body   String? @db.Text
  handle String

  // SEO fields (optional — only present if set in Shopify admin)
  seoTitle       String?
  seoDescription String? @db.Text

  // ── PLAN_CONTENT_CREATION Phase 0 ────────────────────────────────────────
  // Read `attributesSyncedAt` before any of these — see Product for why.
  templateSuffix String?
  isPublished    Boolean   @default(true)
  publishedAt    DateTime?

  attributesSyncedAt DateTime?

  // Shopify Metadata
  shopifyUpdatedAt DateTime
  lastSyncedAt     DateTime @default(now())

  @@unique([shop, id])
  @@index([shop])
  @@index([lastSyncedAt])
}

model ShopPolicy {
  id    String  @id // Shopify GID (e.g., "gid://shopify/ShopPolicy/123")
  shop  String
  title String
  body  String? @db.Text
  type  String // "CONTACT_INFORMATION", "LEGAL_NOTICE", "PRIVACY_POLICY", "REFUND_POLICY", "SHIPPING_POLICY", "TERMS_OF_SERVICE"
  url   String?

  // Shopify Metadata
  lastSyncedAt DateTime @default(now())

  @@unique([shop, id])
  @@index([shop])
  @@index([shop, type])
  @@index([lastSyncedAt])
}

model Menu {
  id     String @id // Shopify GID (e.g., "gid://shopify/Menu/123")
  shop   String
  title  String
  handle String
  items  Json   @db.JsonB // Store the entire menu items structure as JSON

  // Shopify Metadata
  lastSyncedAt DateTime @default(now())

  @@unique([shop, id])
  @@index([shop])
  @@index([lastSyncedAt])
}

model ContentTranslation {
  id String @id @default(cuid())

  // Polymorphic relation (can belong to Product, Collection, Article, Page, or ShopPolicy).
  // NO foreign key / ON DELETE CASCADE is possible: `resourceId` points at one
  // of several different parent tables depending on `resourceType`, which a
  // single SQL FK cannot express. Lifecycle is therefore enforced in app code:
  //   - GDPR/uninstall purge: redactShopData() in app/services/gdpr.service.ts
  //     deletes every row by `shop` (covered by a schema-drift guard test that
  //     fails if a shop-scoped model is added without a deleteMany there).
  //   - Per-resource deletes: callers must delete matching ContentTranslation
  //     rows by (shop, resourceId) — there is no DB safety net.
  // The explicit `shop` column below exists precisely to make these bulk
  // tenant-scoped deletes safe and indexable.
  resourceId   String // The GID of the parent resource
  resourceType String // "Product", "Collection", "Article", "Page", or "ShopPolicy"
  shop         String // Defense-in-depth: explicit shop scope for multi-tenant isolation

  key    String // "title", "body_html", "body", "description", "handle", "meta_title", "meta_description"
  value  String  @db.Text
  locale String // "en", "fr", "es", "it", etc.
  digest String? // Shopify digest for updates

  // Market dimension (Shopify "Translate & Adapt"): "" = global (all markets,
  // legacy behaviour). Non-empty = gid://shopify/Market/<id>, a market-specific
  // override of the global translation for the same locale. Sentinel "" (not
  // NULL) so the composite unique key treats "one global row" deterministically
  // across DB engines — NULLs are considered distinct in unique constraints.
  marketId String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, resourceId, key, locale, marketId])
  // shop-prefixed so lookups stay within one tenant's index range instead of
  // scanning across all shops' rows for a (resourceId, locale) pair.
  @@index([shop, resourceId, locale, marketId])
  @@index([resourceType])
  @@index([locale])
  @@index([shop, resourceType])
  @@index([shop, resourceType, resourceId]) // For bulk joins in loaders - improves query performance by 40-60%
}

// ============================================
// THEME CONTENT MODELS (Background Sync)
// ============================================

model ThemeContent {
  id                  String   @id @default(cuid())
  shop                String
  resourceId          String // Shopify GID
  resourceType        String // "ONLINE_STORE_THEME", "ONLINE_STORE_THEME_JSON_TEMPLATE", etc.
  resourceTypeLabel   String // "Theme Content", "JSON Templates", etc.
  // Top-level content rubric this row belongs to. Lets the four content rubrics
  // (Theme, System, Online-Store-Extras, Selling-Plans) share the ThemeContent
  // table while each route/sync path scopes itself to its own domain.
  // "theme" | "system" | "online_store_extras" | "selling_plans"
  domain              String   @default("theme")
  groupId             String // "article", "collection", "product", "misc_cart", etc.
  groupName           String // "Article", "Collection", "Cart", etc.
  groupIcon           String // "📝", "📂", "🛒", etc.
  translatableContent Json // Array of translatable items with keys and values
  // True only for ONLINE_STORE_THEME_APP_EMBED rows that belong to OUR app
  // (block.type app-handle matches contentpilot). Our embeds are pure technical
  // selectors/config, so the editor locks them read-only in every locale; other
  // apps' embeds stay editable. Derived from settings_data.json at full sync.
  appEmbedOwned       Boolean  @default(false)
  // AI-generated concise nav title in the shop's main language. Only set for
  // rows whose raw name is unusable in a list (currently EMAIL_TEMPLATE, whose
  // groupName is the full localized email subject line). null = not yet
  // generated / not applicable. Written once by the title-backfill task and
  // preserved across syncs (groupName is recomputed every sync, this is not).
  // The loader prefers this over groupName for the item title.
  aiShortTitle        String?
  // Shopify Theme-GID this row belongs to ("gid://shopify/OnlineStoreTheme/<id>").
  // "" = Legacy/vor der Theme-Auswahl-Migration (Backfill-Kandidat). Derived at
  // sync time from the theme_id embedded in the resourceId GID (see
  // app/utils/theme-id.ts), falling back to the active MAIN theme.
  themeId             String   @default("")
  lastSyncedAt        DateTime @default(now())

  @@unique([shop, resourceId, groupId, themeId])
  @@index([shop])
  @@index([shop, groupId])
  @@index([shop, domain])
  @@index([shop, themeId])
  @@index([lastSyncedAt])
}

model ThemeTranslation {
  id         String  @id @default(cuid())
  shop       String
  resourceId String // Links to ThemeContent
  // Mirrors ThemeContent.domain (see there). Lets each rubric load/delete its
  // own translations without touching the others.
  domain     String  @default("theme")
  groupId    String // For faster queries
  key        String // Translation key
  value      String  @db.Text
  locale     String // "en", "fr", "es", "it", etc.
  outdated   Boolean @default(false)
  // Shopify Theme-GID this translation belongs to. Mirrors ThemeContent.themeId
  // (see there). "" = Legacy/vor der Theme-Auswahl-Migration.
  themeId    String  @default("")

  // Market dimension — see ContentTranslation.marketId. "" = global.
  marketId String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Unique key folds BOTH the theme (Theme-Auswahl) and market (Translate &
  // Adapt) dimensions. Explicit map: the auto-generated name would exceed
  // Postgres's 63-char limit. Built by migration 20260706140000 (after both the
  // theme-id and market-id migrations, which each create a transient one-sided
  // index the reconciliation migration replaces).
  @@unique([shop, resourceId, groupId, key, locale, themeId, marketId], map: "ThemeTranslation_shop_res_grp_key_loc_theme_market_key")
  @@index([shop, resourceId, groupId])
  @@index([shop, groupId, locale]) // For efficient locale-specific group queries
  @@index([shop, domain])
  @@index([shop, themeId])
  @@index([locale])
}

// ============================================
// METAOBJECT MODELS (Background Sync)
// ============================================

model MetaobjectDefinition {
  id               String  @id // Shopify GID (e.g., "gid://shopify/MetaobjectDefinition/123")
  shop             String
  type             String // Metaobject type identifier (e.g., "size_guide", "product_spec")
  name             String // Display name
  description      String? @db.Text
  /// Array of field definitions. Shape (PLAN_CONTENT_CREATION Phase 0):
  ///   { key, name, type: { name }, required, validations: [{ name, value }] }
  ///
  /// `required` and `validations` were added in Phase 0 — WITHOUT them the
  /// create form cannot mark a field as mandatory, and it would offer entries
  /// Shopify then rejects (§1.5). Rows synced before Phase 0 carry entries
  /// with `required` ABSENT: absent ≠ false. A reader that needs the flag must
  /// treat `undefined` as "unknown" and re-sync, not as "optional".
  fieldDefinitions Json

  /// PLAN_METAOBJECTS_EDITOR §7.2 — Shopify's `MetaobjectAccess.admin` for this
  /// definition ("MERCHANT_READ_WRITE", "MERCHANT_READ", "PRIVATE", ...).
  ///
  /// NULL means UNKNOWN — the row predates the column or the sync could not
  /// read it — and is NEVER read as "writable" or as "read-only". Only a value
  /// this app KNOWS excludes writes locks the entry editor; unknown behaves as
  /// it always did and offers a resync. Same discriminator rule as
  /// `attributesSyncedAt`.
  adminAccess String?

  /// Shopify's `capabilities.translatable.enabled` for this definition.
  ///
  /// NULL means UNKNOWN — the row predates the column, or a narrower query did
  /// not carry it — and is NEVER read as "does not translate". Only a KNOWN
  /// false takes a type out of the "this locale still needs work" count, which
  /// is what keeps the language buttons from pulsing forever on a type whose
  /// Translations capability is simply switched off. Same rule as
  /// `adminAccess` above.
  translatableCapability Boolean?

  lastSyncedAt DateTime @default(now())

  @@unique([shop, id])
  @@unique([shop, type])
  @@index([shop])
  @@index([lastSyncedAt])
}

model Metaobject {
  id          String @id // Shopify GID (e.g., "gid://shopify/Metaobject/123")
  shop        String
  type        String // Links to MetaobjectDefinition.type
  handle      String
  displayName String // Primary locale display name
  fields      Json // Array of field values {key, value, type}

  // Shopify Metadata
  shopifyUpdatedAt DateTime
  lastSyncedAt     DateTime @default(now())

  @@unique([shop, id])
  @@index([shop])
  @@index([shop, type])
  @@index([lastSyncedAt])
}

model MetaobjectTranslation {
  id           String  @id @default(cuid())
  shop         String
  metaobjectId String // Shopify GID of the metaobject
  type         String // Metaobject type (for grouping)
  key          String // Field key (e.g., "display_name", "name", "label")
  value        String  @db.Text
  locale       String // "en", "fr", "es", "it", etc.
  outdated     Boolean @default(false)

  // Market dimension — see ContentTranslation.marketId. "" = global.
  marketId String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, metaobjectId, key, locale, marketId])
  @@index([shop, metaobjectId])
  @@index([shop, type, locale]) // For efficient type-specific locale queries
  @@index([locale])
}

/// Templates for bulk alt text generation with variable placeholders (e.g. {Farbe}).
model AltTextTemplate {
  id            String   @id @default(cuid())
  shop          String
  productId     String
  position      Int // image position (1-based: 1 = main image, 2 = first gallery, …); legacy rows may use 0-based
  positionLabel String? // optional user-defined label, e.g. "Main Image"
  locale        String // "de", "en", "fr", etc.
  template      String   @db.Text // e.g. "Eleganter {Farbe} Blumentopf"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([shop, productId, position, locale])
  @@index([shop, productId])
}

/// Glossar/Terminologie (docs/plans/GLOSSARY_IMPLEMENTATION_PLAN.md): one entry
/// per source term in the shop's primary locale. Injected into every AI
/// translation prompt via AIService.getGlossaryDirective().
///   doNotTranslate = true  -> keep the term verbatim in ALL target languages
///   translations           -> per-locale fixed ("always exactly this") renderings
///   no translation row     -> no rule for that locale, the AI translates freely
model GlossaryEntry {
  id             String   @id @default(cuid())
  shop           String
  sourceTerm     String
  sourceLocale   String // shop primary locale at creation time
  doNotTranslate Boolean  @default(false)
  caseSensitive  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  translations GlossaryEntryTranslation[]

  @@unique([shop, sourceTerm, sourceLocale])
  @@index([shop])
}

/// Fixed target-locale rendering of a GlossaryEntry ("always translate exactly
/// so"). Shop scoping is inherited through the entry (cascade on delete), so
/// GDPR shop-redact only needs to delete GlossaryEntry rows.
model GlossaryEntryTranslation {
  id      String        @id @default(cuid())
  entryId String
  entry   GlossaryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  locale  String
  value   String

  @@unique([entryId, locale])
  @@index([entryId])
}

/// Persistent audit trail for GDPR compliance requests.
/// Entries are retained for 3 years (Art. 5(2) GDPR accountability) and are
/// deliberately NOT deleted on shop/redact. The 3-year upper bound is enforced
/// by GdprAuditLogCleanupService (src/services/gdpr-audit-cleanup.service.ts;
/// standalone mirror gdpr-audit-cleanup.service.js, started from server.js),
/// which runs daily and deletes only rows where requestedAt < now − 3 years.
model GdprAuditLog {
  id            String   @id @default(cuid())
  shop          String
  requestType   String // "data_request" | "customer_redact" | "shop_redact"
  customerId    BigInt?
  customerEmail String?
  status        String // "completed" | "failed"
  dataExported  String?  @db.Text // R5-G1: FULL data_request export JSON (≤1 MB), surfaced in admin
  error         String?  @db.Text
  // R5-G4: Shopify X-Shopify-Webhook-Id — correlates redelivered (non-2xx
  // retried, up to ~48h) compliance attempts in this append-only trail.
  webhookId     String?
  requestedAt   DateTime @default(now())
  completedAt   DateTime @default(now())

  @@index([shop])
  @@index([shop, requestType])
  @@index([requestedAt])
  @@index([webhookId])
}

/// Tracks per-shop install lifecycle so the 30-day reaper has a reliable
/// "inactive since" anchor. `uninstalledAt` is set by the APP_UNINSTALLED
/// webhook and cleared (set null) on every (re)install via afterAuth.
model ShopInstallState {
  shop                      String    @id
  uninstalledAt             DateTime?
  // Set ONCE when the initial full sync (incl. product translations) completes
  // successfully (initial-sync.service). Onboarding (app._index) and the
  // sync-stream products gate key off THIS marker, not db.product.count — a
  // Remix prefetch of the products loader populates db.product before the
  // initial sync runs, so a count-based gate would skip translations forever.
  // null = initial sync not yet completed (run onboarding). Deleted together
  // with products on full GDPR wipe (gdpr.service) → reinstall re-onboards.
  initialSyncCompletedAt    DateTime?
  // Server-side initial-sync progress, written (throttled) by the sync scheduler
  // so the persistent onboarding banner can poll it without an open SSE stream.
  // initialSyncStartedAt anchors the 3h bypass cap (process-restart safe).
  // initialSyncForceRequested is set by the Settings "Sync Products" re-sync
  // trigger and consumed (force-delete + full re-pull) by the scheduler.
  initialSyncStartedAt      DateTime?
  initialSyncPhase          String?
  initialSyncPercent        Int?
  initialSyncStats          Json?
  initialSyncError          String?
  initialSyncForceRequested Boolean   @default(false)
  updatedAt                 DateTime  @updatedAt

  @@index([uninstalledAt])
}

// Rolling monthly counter for billable image operations (Bulk-Upload + WebP
// conversion). One row per (shop, period). Usage data only — NOT entitlement
// data, so it is intentionally absent from getSyncScope / planCacheCleanup;
// the quota is enforced lazily at the upload/convert routes. See
// docs/ROADMAP.md §Limit-Review Befund 3.
model ImageOperationCounter {
  id        String   @id @default(cuid())
  shop      String
  period    String // "YYYY-MM" (UTC)
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([shop, period])
  @@index([shop])
}

// SEO tab Phase 3: storefront 404 hits, reported by the theme app-embed beacon
// through the /apps/contentpilot/seo-404 app-proxy. Shopify exposes no 404 logs
// via API, so we collect them ourselves. Mirrors DirectTranslationCandidate:
// upsert-increment per path, FIFO-pruned per shop (MAX_404_HITS_PER_SHOP), and
// purged in redactShopData (the GDPR schema-coverage guard requires it).
model Seo404Hit {
  id          String   @id @default(cuid())
  shop        String
  path        String   @db.Text // requested storefront path (may be long)
  pathHash    String // sha256 of the normalized path — the upsert key
  referrer    String?  @db.Text
  count       Int      @default(1)
  status      String   @default("new") // "new" | "redirected" | "dismissed"
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([shop, pathHash])
  @@index([shop, status])
  // Backs the FIFO-prune query (delete oldest-untouched when a shop exceeds the
  // cap) and the "most frequent / most recent" admin listing.
  @@index([shop, lastSeenAt])
  @@index([shop, count])
}

// Keywords expansion (PLAN_KEYWORDS_EXPANSION.md §2): a keyword is a
// standalone shop-scoped object — item linkage lives in SeoKeywordAssignment,
// group membership in SeoKeywordGroupMembership. keyword is stored lowercased
// + single-spaced (normalizeKeyword). Shop-scoped; purged in redactShopData
// (the GDPR schema-coverage guard requires it).
model SeoKeyword {
  id       String @id @default(cuid())
  shop     String
  keyword  String // lowercased, single-spaced (normalizeKeyword)
  locale   String @default("") // "" = primary/default locale
  priority Int    @default(2) // 1 = high, 2 = medium, 3 = low

  assignments SeoKeywordAssignment[]
  groups      SeoKeywordGroupMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, keyword, locale])
  @@index([shop, priority])
  @@index([shop, keyword])
}

// One keyword ↔ item link with an explicit role. GSC enrichment lives HERE
// (not on SeoKeyword) because GSC reports (query, page) tuples — the same
// query can rank on two items with different positions.
//
// At most ONE role='primary' per (item, locale) — enforced in the app layer
// (the locale hangs off the keyword, Prisma can't express it): the assignment
// writer does check+swap INSIDE a transaction (two parallel writers could
// otherwise both create a primary). Leftover duplicates are surfaced by the
// Phase-5 cannibalization card rather than silently kept.
model SeoKeywordAssignment {
  id           String @id @default(cuid())
  shop         String
  keywordId    String
  resourceType String // "Product" | "Collection" | "Article" | "Page"
  resourceId   String // Shopify GID
  role         String // "primary" | "secondary"

  // GSC enrichment (written by the GSC sync; null until connected).
  gscPosition    Float?
  gscClicks      Int?
  gscImpressions Int?
  gscCtr         Float?
  gscUpdatedAt   DateTime?

  keyword   SeoKeyword           @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  snapshots SeoKeywordSnapshot[]

  createdAt DateTime @default(now())

  @@unique([shop, keywordId, resourceId])
  @@index([shop, resourceType, resourceId])
  // The AI-prompt bridge (text-generation.handler.ts) filters on
  // (shop, resourceId) WITHOUT resourceType — this index backs that query.
  @@index([shop, resourceId])
  @@index([shop, keywordId])
}

// Keyword groups are pure management containers (CSV import target, table
// facet, AI-distribution entry point). A group is NEVER assigned to an item
// as a whole — assignment is always per keyword (see the plan §1).
model SeoKeywordGroup {
  id          String  @id @default(cuid())
  shop        String
  name        String
  locale      String  @default("") // "" = primary/default locale (SeoKeyword convention)
  description String?

  memberships SeoKeywordGroupMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, name, locale])
  @@index([shop, locale])
}

// M:N keyword ↔ group. Carries its own `shop` column (denormalized) so the
// GDPR purge can deleteMany({ shop }) directly — the schema-coverage guard
// checks for a shop field, not for cascades.
model SeoKeywordGroupMembership {
  id        String @id @default(cuid())
  shop      String
  groupId   String
  keywordId String

  group   SeoKeywordGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  keyword SeoKeyword      @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([groupId, keywordId])
  @@index([shop])
}

// Ranking history: one row per (assignment, sync day), so the UI can chart
// position/clicks/impressions/ctr over time instead of only ever seeing the
// latest GSC values. Hangs off the ASSIGNMENT (like the live GSC columns)
// because GSC data is per (query, page). capturedAt is truncated to UTC
// midnight so a manual sync and the daily auto-sync on the same day collapse
// into one row (see the unique index). Shop-scoped; purged in redactShopData
// (GDPR schema-coverage guard) and pruned by enrichKeywordsFromGsc after 400
// days.
model SeoKeywordSnapshot {
  id           String   @id @default(cuid())
  shop         String
  assignmentId String
  capturedAt   DateTime
  position     Float?
  clicks       Int?
  impressions  Int?
  ctr          Float?
  createdAt    DateTime @default(now())

  assignment SeoKeywordAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, capturedAt])
  @@index([shop])
}

// SEO tab Phase 6: per-shop Google Search Console OAuth connection. The
// refresh token is stored ENCRYPTED (same AES-256-GCM utility as the AI API
// keys); access tokens are derived per-request and never persisted. Shop-scoped
// (shop is the PK) and purged in redactShopData (GDPR schema-coverage guard).
model GoogleSearchConsoleConnection {
  shop         String   @id
  propertyUrl  String // GSC property, e.g. "sc-domain:example.com" or "https://example.com/"
  refreshToken String   @db.Text // encrypted at rest
  email        String? // connected Google account (display only)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Last time app/services/seo/gsc-auto-sync.service.ts (or the merchant's
  // manual "Sync keyword rankings" button) wrote GSC data onto SeoKeyword
  // rows. Null = never synced. Drives the daily auto-sync's "is this
  // connection due" query; also stamped (with a backoff, see the service's
  // doc comment) on plan-gate/no-keywords skips and sync errors so a shop
  // that can't be synced doesn't get retried on every tick.
  lastKeywordSyncAt DateTime?
}

// Visits that arrived from an AI assistant (ChatGPT, Perplexity, Claude, …).
//
// Aggregate ONLY: one row per (shop, source, UTC day, landing path) with a
// counter. No visitor identifier, no cookie, no session, no IP — the beacon
// sends the referrer's classified SOURCE, never the referrer itself, so a
// referrer carrying a conversation id or a search term cannot land in the
// database at all. That is what makes this reportable without a consent
// dialog, and it is also why the report can never answer "which visitor".
//
// Day bucketing rather than raw hits keeps the table bounded (sources ×
// paths × days) and is the granularity the report actually draws.
model SeoAiReferral {
  id       String   @id @default(cuid())
  shop     String
  // Normalized source key from classifyAiReferral (e.g. "chatgpt"), never the
  // raw referrer.
  source   String
  // UTC day bucket. Date, not DateTime: the report groups by day and a
  // timestamp would fragment every bucket by the millisecond.
  day      DateTime @db.Date
  // Landing path, query stripped (same rule as Seo404Hit).
  path     String
  pathHash String
  count    Int      @default(1)

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([shop, source, day, pathHash])
  @@index([shop, day])
  @@index([shop, source, day])
}

// SEO tab Phase 8: IndexNow config (per shop). The `key` is a PUBLIC token by
// design (it is served at keyLocation for verification), so it is intentionally
// stored in plaintext — NOT a secret. Shop-scoped; purged in redactShopData.

model SeoIndexNowConfig {
  shop             String    @id
  key              String // public IndexNow token (plaintext by design)
  // URL where the key file is served: `https://<host>/<key>.txt` — the ROOT of
  // the storefront, because a key under a sub-path only verifies that sub-path
  // (measured; see the service header). A Shopify URL redirect maps that root
  // path onto the app proxy, which does the actual serving.
  keyLocation      String
  // GID of that `urlRedirect`, so it can be updated/removed instead of
  // orphaned in the merchant's admin. null = not created yet (every row the
  // migration backfilled) — the section loader and the sweep repair it.
  keyRedirectId    String?
  // Storefront host every submission uses for `host`, `urlList` AND
  // `keyLocation` — the shop's PRIMARY domain, not `*.myshopify.com`. Shopify
  // 301s the myshopify host to the primary domain, which would make both the
  // submitted URLs and the ownership check land on a different host than the
  // one declared. Persisted (not resolved per call) so webhooks can build URLs
  // from the config row they already loaded; `syncIndexNowHost` refreshes it
  // whenever the merchant opens the section, so adding a custom domain later
  // fixes itself WITHOUT minting a new key.
  host             String
  // Last time `host` was checked against the shop's actual primary domain.
  // null = never verified (the migration backfill, or a provision whose lookup
  // failed) — the background sweep refreshes those first, so a shop that never
  // reopens the section still stops submitting myshopify URLs.
  hostCheckedAt    DateTime?
  enabled          Boolean   @default(true)
  // Last successful submission of ANY kind (queue drain or full catalog).
  lastSubmittedAt  DateTime?
  // Last successful FULL-catalog submit — separate from lastSubmittedAt so the
  // "submit everything" cooldown isn't reset by every queue drain.
  lastFullSubmitAt DateTime?
  // Stamped by the background sweep on EVERY path (success, skip, error) so an
  // ineligible shop can't win the "due" query forever — same guard the
  // llms/GSC sweeps document. NOT a lock.
  lastAutoRunAt    DateTime?
  // Rolling monthly submission quota (PlanLimits.seo.monthlyIndexNowSubmissions).
  // `submitPeriod` is the UTC "YYYY-MM" key the counter belongs to — the same
  // convention as the image-operation quota, so a new month resets the counter
  // lazily on the next write instead of needing a cron. Usage data, not
  // entitlement data: never touched by planCacheCleanup.
  submitPeriod     String?
  submitCount      Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Drives the sweep's due-query (index-now-auto-submit.service.ts).
  @@index([enabled, lastAutoRunAt])
}

// SEO tab Phase 8: debounced queue of changed storefront URLs to submit to
// IndexNow (fed by product/collection webhooks, drained on demand). Shop-scoped;
// purged in redactShopData.
model SeoIndexNowQueue {
  id        String   @id @default(cuid())
  shop      String
  url       String   @db.Text
  urlHash   String // dedupe key (sha256 of url)
  createdAt DateTime @default(now())

  @@unique([shop, urlHash])
  @@index([shop])
}

// SEO Audit Dashboard: a point-in-time snapshot of analyzeStore()'s result
// (audit.service.ts), persisted so the dashboard reads a cached history
// instead of re-scanning the full content cache on every visit. `payload` is
// the full JSON.stringify(StoreAudit) (distribution, byType, problems incl.
// items, worstOffenders) — the averageScore/totalScanned/totalAvailable/capped
// columns are denormalized copies kept alongside it so the lightweight trend
// query (getAuditTrend) never has to parse the payload. Written by the
// detached "seoAudit" Task runner (seo-audit.handler.ts); pruned to the newest
// 30 rows per shop on every write (see saveAuditSnapshot). Shop-scoped;
// purged in redactShopData.
model SeoScoreSnapshot {
  id             String   @id @default(cuid())
  shop           String
  createdAt      DateTime @default(now())
  averageScore   Int
  totalScanned   Int
  totalAvailable Int
  capped         Boolean
  payload        String   @db.Text // JSON.stringify(StoreAudit)

  // Per-locale snapshots for the SEO overview language switcher.
  // "" (sentinel) = primary locale, mirrors ContentTranslation.marketId's
  // "" = global convention. Non-empty = a shop-locale code like "en", "fr".
  locale String @default("")

  @@index([shop, locale, createdAt])
}

// SEO tab Performance section: cached PageSpeed Insights v5 runs, keyed by
// (shop, url, strategy). `result` is the parsed PageSpeedAuditResult (see
// app/services/seo/pagespeed.types.ts + pagespeed.service.ts) — `score`,
// `a11yScore` and `bestPracticesScore` are denormalized copies of the
// category scores in `result` so the trend/history list (listPageSpeedHistory)
// never has to parse the JSON blob. Pruned to the newest 10 rows per
// (shop, url, strategy) on every write (runPageSpeedAudit).
// Shop-scoped; purged in redactShopData (GDPR schema-coverage guard).
model SeoPageSpeedAudit {
  id                 String   @id @default(cuid())
  shop               String
  url                String
  strategy           String // "mobile" | "desktop"
  score              Int? // Lighthouse performance score 0-100 (denormalized for history lists)
  a11yScore          Int? // Lighthouse accessibility score 0-100 (denormalized for history lists)
  bestPracticesScore Int? // Lighthouse best-practices score 0-100 (denormalized for history lists)
  result             Json // PageSpeedAuditResult
  createdAt          DateTime @default(now())

  @@index([shop, url, strategy, createdAt])
  @@index([shop, createdAt])
}

// SEO tab Performance section, Phase 2: real-user web-vitals (RUM) samples
// beaconed from the storefront (see extensions/storefront's web-vitals beacon,
// app/routes/proxy.web-vitals.tsx, app/services/seo/web-vitals.service.ts).
// One row per page-load beacon. No visitor identifiers are stored — only
// path/template/device, metric values, and element labels (see
// web-vitals.types.ts header comment on privacy). Retention is pruned to 45
// days per shop by recordWebVitalSample. Shop-scoped; purged in
// redactShopData (GDPR schema-coverage guard).
model SeoWebVitalSample {
  id         String   @id @default(cuid())
  shop       String
  path       String
  template   String
  device     String // "mobile" | "desktop"
  lcpMs      Float?
  cls        Float?
  inpMs      Float?
  fcpMs      Float?
  ttfbMs     Float?
  lcpElement String?
  clsElement String?
  inpElement String?
  createdAt  DateTime @default(now())

  @@index([shop, createdAt])
  @@index([shop, template, device, createdAt])
}

// ── Phase 1 (Storefront crawler / site audit, PLAN_SEO_SUITE_COMPLETION.md
// §2/§3) ─────────────────────────────────────────────────────────────────
//
// One row per "Jetzt scannen" run (seoCrawl Task, seo-crawl.handler.ts /
// crawl.service.ts). Children (SeoCrawlPage, SeoCrawlBrokenLink) cascade on
// delete but ALSO carry their own `shop` column — the GDPR schema-coverage
// guard (tests/unit/gdpr.service.test.ts) checks for a `shop`/`shopId` field
// per model and expects an explicit deleteMany, not a cascade, so every
// child needs the column even though the FK alone would clean it up.
// Retention: on a new crawl start, delete all but the newest 5 snapshots per
// shop (see pruneOldCrawlSnapshots in crawl.service.ts) — cascade removes the
// pruned snapshots' pages/brokenLinks with them.
model SeoCrawlSnapshot {
  id              String    @id @default(cuid())
  shop            String
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  status          String // "running" | "completed" | "failed" | "capped"
  error           String? // short reason on "failed" (e.g. "storefront_password", "bot_blocked")
  pagesCrawled    Int       @default(0)
  totalDiscovered Int       @default(0) // URLs found, even beyond the cap
  pagesOk         Int       @default(0)
  pagesBroken     Int       @default(0)
  orphanCount     Int       @default(0)
  headDriftCount  Int       @default(0)

  pages         SeoCrawlPage[]
  brokenLinks   SeoCrawlBrokenLink[]
  externalLinks SeoCrawlExternalLink[]

  @@index([shop, startedAt])
}

// One row per crawled URL (post query-strip/dedupe normalization, §3.2).
// `resourceType`/`resourceId` are resolved via the shared
// `resolvePathsToResources` (seo/url-resolver.server.ts) — null when the path
// doesn't map to a known content type (theme/metaobject pages, §3.8).
model SeoCrawlPage {
  id             String  @id @default(cuid())
  shop           String
  snapshotId     String
  url            String // normalized URL (query params stripped, §3.2)
  statusCode     Int
  redirectedTo   String? // final URL, if a 3xx chain was followed
  responseMs     Int
  title          String? // <title> from the rendered HTML
  metaDesc       String?
  canonical      String?
  h1Count        Int     @default(0)
  wordCount      Int     @default(0)
  resourceType   String? // "product" | "collection" | "article" | "page" | "unknown"
  resourceId     String? // Shopify GID, when resolvable (editor deep-link)
  locale         String  @default("") // from the URL prefix (/fr/...) — "" = primary
  inboundCount   Int     @default(0) // internal links pointing HERE
  outboundCount  Int     @default(0)
  // schema.org @type values found in the page's <script type="application/ld+json">
  // blocks, comma-separated, REPEATS PRESERVED ("Product,Product" = two blocks,
  // which is what makes duplicate markup detectable). "" = none found, which is
  // also what every row written before this column existed reports.
  jsonLdTypes    String  @default("")
  // Subset of jsonLdTypes emitted by THIS app's storefront block, identified by
  // its data-contentpilot attribute. Lets the report say which copy of a
  // duplicated type is ours — the delivered HTML tells nobody otherwise.
  jsonLdAppTypes String  @default("")

  // PLAN_SEO_CRAWL_EXPANSION §1.1 / §2.1-§2.2 — indexability, stored RAW and
  // never pre-interpreted: `deriveIndexability` (onpage.service.ts) is a pure
  // function over these two columns, so the rule can be corrected without a
  // re-crawl.
  //
  // TRAP (same shape as jsonLdTypes / translatableContent): "" means TWO
  // indistinguishable things — no tag/header was served, OR the row was written
  // before these columns existed. `indexabilityKnown` is the discriminator: it
  // is only true when THIS crawl run actually looked (i.e. a body was parsed).
  // The UI hides the whole category when the latest snapshot doesn't know,
  // rather than claiming "everything is fine".
  metaRobots        String  @default("") // <meta name="robots" content="…"> (+ name="googlebot", appended)
  xRobotsTag        String  @default("") // X-Robots-Tag of the FINAL response of the redirect chain
  indexabilityKnown Boolean @default(false)

  // §1.1 / §2.3 — on-page. h1Count above only counts; the text is what makes
  // "H1 equals the title" and "H1 is empty" checkable at all.
  h1First       String?
  imgCount      Int     @default(0)
  // Images WITHOUT a non-empty alt attribute. `alt=""` is valid HTML for
  // decorative images and is counted here as missing — the UI must therefore
  // say "without alt text", never "error" (§2.3).
  imgMissingAlt Int     @default(0)

  // §2.4 — observed redirect chain length (0 = no redirect). `redirectedTo`
  // above holds the end of the chain; the hop count is the report value.
  redirectHops Int @default(0)

  // PLAN_MARKUP_ACTIVATION §2.1 — Open Graph / Twitter Cards, measured exactly
  // like jsonLdTypes above and for the same reason: most themes set og:title
  // and og:image themselves, and two og:image tags on one page are for
  // Facebook/LinkedIn what two Product nodes are for Google.
  //
  // Full property names, comma-separated, REPEATS PRESERVED ("og:image,
  // og:image" = two tags, which is what makes duplication detectable).
  ogTags      String  @default("")
  twitterTags String  @default("")
  // The subset THIS app's social-meta block emitted, identified by its
  // data-contentpilot attribute — holds both namespaces, since the names carry
  // their own prefix. Same purpose as jsonLdAppTypes: the delivered HTML tells
  // nobody otherwise which of two copies is ours.
  ogAppTags   String  @default("")
  // The discriminator, same shape as indexabilityKnown: "" above means EITHER
  // "nothing served" OR "row written before these columns existed". Only ever
  // true when this crawl actually parsed a body and looked.
  socialKnown Boolean @default(false)

  snapshot SeoCrawlSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, url])
  @@index([shop, snapshotId])
  @@index([shop, snapshotId, statusCode])
}

// A same-origin link edge whose target failed (>=400, timeout, or a redirect
// loop/too-many-hops). The link GRAPH itself is not persisted (§2 — would be
// ~200k rows/crawl on a 2000-page site); only broken edges land here.
model SeoCrawlBrokenLink {
  id         String  @id @default(cuid())
  shop       String
  snapshotId String
  fromUrl    String
  toUrl      String
  statusCode Int // 404/410/5xx; 0 = timeout, -1 = redirect chain >3 hops / loop
  anchor     String?

  snapshot SeoCrawlSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([shop, snapshotId])
}

// PLAN_SEO_CRAWL_EXPANSION §1.2 / §6 — outbound links to OTHER domains, checked
// in a second pass after the crawl itself is already persisted.
//
// One row per UNIQUE target URL, never per edge: an Instagram link in the footer
// appears on every page and would otherwise write 2000 identical rows.
// `sourceCount` keeps how many pages point at it, `sampleSources` up to 5 of
// them. Dedup is by the FULL url including the query string (unlike the internal
// crawl, which strips it — on an external target the query usually carries
// meaning).
model SeoCrawlExternalLink {
  id            String   @id @default(cuid())
  shop          String
  snapshotId    String
  url           String
  statusCode    Int // 0 = timeout/DNS/blocked-by-guard, -1 = redirect loop / too many hops
  finalUrl      String? // set when the link redirected ("http:// → https://" is a finding in itself)
  sourceCount   Int      @default(0)
  sampleSources String   @default("") // up to 5 source URLs, "\n"-separated
  anchor        String?
  checkedAt     DateTime @default(now())

  snapshot SeoCrawlSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, url])
  @@index([shop, snapshotId])
  @@index([shop, snapshotId, statusCode])
}

// Phase 3 (Content-Freshness audit, PLAN_SEO_SUITE_COMPLETION.md §2/§5.1
// option b): per-page GSC rollup. Written daily by
// app/services/seo/gsc-auto-sync.service.ts (one extra dimensions:["page"]
// query, 90d window, alongside the existing per-keyword sync) via
// enrichPageStatsFromGsc (google-search-console.server.ts). resourceType/
// resourceId are resolved via the shared resolvePathsToResources
// (seo/url-resolver.server.ts) — null when the page doesn't map to a known
// content type. Read by app/services/seo/freshness.service.ts.
// Retention: the unique (shop, page) key overwrites on every sync — no
// history table (PLAN §2 "Retention").
model SeoGscPageStat {
  id           String   @id @default(cuid())
  shop         String
  page         String // full GSC page URL
  resourceType String? // "Product" | "Collection" | "Article" | "Page" | null
  resourceId   String? // Shopify GID, when resolved
  position     Float
  clicks       Int
  impressions  Int
  ctr          Float
  windowDays   Int      @default(90)
  syncedAt     DateTime @default(now())

  @@unique([shop, page])
  @@index([shop, resourceType, resourceId])
}

// Phase 2 (Internal Linking, PLAN_SEO_SUITE_COMPLETION.md §2/§4): one
// suggested internal link "source item mentions target item's anchor text
// → link to it". resourceType uses the SAME capitalized convention as
// ContentTranslation/SeoKeywordAssignment/SeoGscPageStat ("Product" |
// "Collection" | "Article" | "Page"), since the matcher's target set is
// built from SeoKeywordAssignment and the source set includes ContentTranslation-
// adjacent content — NOT SeoCrawlPage's lowercase convention.
// locale is always "" (primary) in v1 — Phase 2 explicitly does not match
// across locales (see internal-links.service.ts header).
// Idempotent across re-runs via the composite unique key; a `dismissed` row
// whose dismissedUntil is still in the future is never reactivated by a
// later run (internal-links.service.ts upsertSuggestions).
model SeoInternalLinkSuggestion {
  id               String    @id @default(cuid())
  shop             String
  locale           String    @default("") // anchor + target always same locale
  fromResourceType String
  fromResourceId   String
  anchorText       String // the mention found in the source content
  toResourceType   String
  toResourceId     String
  confidence       Float
  status           String // "pending" | "accepted" | "dismissed"
  // "Ablehnen" (permanent reject) -> null (never reactivated by a later run).
  // "90 Tage ignorieren" -> a future date (reactivatable once it has passed).
  dismissedUntil   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Default Prisma-generated constraint name would exceed Postgres' 63-byte
  // identifier limit (101 chars) — explicit short `map`, same fix as
  // ThemeTranslation's shop_resourceId_groupId_key_locale_themeId_marketId
  // unique key (see CLAUDE.md).
  @@unique([shop, fromResourceType, fromResourceId, toResourceType, toResourceId, locale], map: "SeoInternalLinkSuggestion_shop_from_to_locale_key")
  @@index([shop, status])
}

// Phase 4 (Sitemap / indexation control, PLAN_SEO_SUITE_COMPLETION.md §2/§6):
// one merchant-facing suggestion (or applied/reverted decision) to exclude a
// resource from Shopify's platform-generated sitemap via the documented
// `seo.hidden` metafield lever (namespace "seo", key "hidden") — set/cleared
// by app/services/seo/sitemap.service.ts's applyExclusion/revertExclusion.
// resourceType uses SeoCrawlPage's lowercase convention ("product" |
// "collection" | "page" | "article" | "blog"), NOT SeoInternalLinkSuggestion's
// capitalized one — sitemap.service.ts builds candidates directly from the
// same AuditType-shaped buckets crawl.service.ts/audit.service.ts use.
//
// Lifecycle: "suggested" (we proposed it) -> "applied" (seo.hidden set via
// API AND Shopify echoed the write back — userErrors alone is not enough,
// CLAUDE.md invariant) -> "reverted" (metafieldsDelete echoed back). A
// re-run of the suggestion sweep upserts idempotently via the unique key
// below and — same rule as SeoInternalLinkSuggestion — never reactivates a
// row the merchant (or a prior apply) already moved off "suggested".
model SeoSitemapExclusion {
  id           String    @id @default(cuid())
  shop         String
  resourceType String // "product" | "collection" | "page" | "article" | "blog"
  resourceId   String // Shopify GID
  reason       String? // "emptyCollection" | "thinContent" | "archivedProduct" | "manual" | …
  status       String    @default("suggested")
  appliedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@unique([shop, resourceType, resourceId])
  @@index([shop, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Media-Bibliothek (Shopify Files) — Cache für den Bulk-Editor
// ─────────────────────────────────────────────────────────────────────────────
// Der Produkt-Sync cacht Produktmedien bereits in `ProductImage`. Bilder, die an
// KEINEM Produkt hängen (Dateien-Bibliothek, Metaobjekt-Referenzen, Theme-
// Bilder) sind dort per Definition nicht enthalten — der Bulk-Editor braucht sie
// aber, weil jedes MediaImage genau einen übersetzbaren Key (`alt`) hat und
// `translatableResources(resourceType: MEDIA_IMAGE)` sie alle aufzählt.
//
// Quelle: files(query:"media_type:IMAGE") — siehe app/services/media-library/
// sync.server.ts. Shopify sagt dort NICHT, wo eine Datei verwendet wird; die
// usage*-Spalten sind eine best-effort-Auflösung aus lokalen Caches und stehen
// bewusst FLACH (nicht als JSON) hier, weil danach gefiltert und sortiert wird.
model MediaLibraryImage {
  id   String @id // gid://shopify/MediaImage/… — zugleich die Übersetzungs-Ressource
  shop String

  url      String
  altText  String? // Primärsprachlicher Alt-Text (null = nicht gesetzt)
  filename String  @default("") // ohne Query-String, "" wenn unbekannt
  mimeType String?

  // Reihenfolge aus dem Sync-Lauf (files(sortKey: CREATED_AT, reverse: true)),
  // damit die Liste ohne zusätzliche Sortierspalte stabil "neueste zuerst" ist.
  position         Int       @default(0)
  shopifyCreatedAt DateTime?

  // Best-effort-Verwendung. usageKind ist ein MediaImageUsageKind-String
  // ("product" | "metaobject" | … | "unknown"); "" bei Owner/Label = unbekannt.
  // NIE geraten: was nicht sicher auflösbar ist, bleibt "unknown".
  usageKind    String @default("unknown")
  usageOwnerId String @default("")
  usageLabel   String @default("")

  lastSyncedAt DateTime @default(now())

  @@unique([shop, id])
  @@index([shop])
  @@index([shop, usageKind])
  @@index([shop, position])
}

// Ein Marker-Row pro Shop: "der Media-Sync ist mindestens einmal bis zum Ende
// gelaufen". Ohne ihn wäre ein Shop ganz ohne Bilder nicht von einem nie
// synchronisierten Shop zu unterscheiden (loadMediaLibraryImages.neverSynced).
//
// `truncated` = die Bibliothek war grösser als das Seitenlimit des Syncs, der
// Cache ist also unvollständig (und wird deshalb auch nie stale-bereinigt).
model MediaLibrarySyncState {
  shop         String   @id
  lastSyncedAt DateTime
  imageCount   Int      @default(0)
  truncated    Boolean  @default(false)
  updatedAt    DateTime @updatedAt
}
