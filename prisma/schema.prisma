generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
  lastActivityAt      DateTime? @default(now())
}

model AISettings {
  id                String  @id @default(cuid())
  shop              String  @unique
  huggingfaceApiKey String?
  geminiApiKey      String?
  claudeApiKey      String?
  openaiApiKey      String?
  grokApiKey        String?
  deepseekApiKey    String?
  preferredProvider String  @default("claude")
  selectedModel     String?
  appLanguage       String  @default("de")
  subscriptionPlan  String  @default("free") // "free", "basic", "pro", "max"

  // How to handle Shopify's richtext rule ("all top level nodes must be
  // <p>/<ul>/<ol>/<h1>-<h6>") when saving primary theme-settings values
  // (e.g. Brand information → brand_description). Merchant-selectable in Settings.
  //   "autofix"   (default) — try the save; if Shopify rejects for this reason,
  //               normalize the offending value's top-level HTML and retry once.
  //   "normalize" — always normalize HTML-bearing theme-settings values before
  //               pushing, no retry round-trip.
  //   "error"     — never rewrite merchant HTML; surface a clear instruction.
  themeRichtextMode String @default("autofix")

  // Dev/test affordance — read ONLY by the custom-app build. The custom-app
  // Shopify distribution has NO Billing API at all, so on that build the plan
  // is decoupled from Shopify and read from here instead. resolveDevPlanMode()
  // (app/services/dev-plan-override.server.ts) gates every read/write behind
  // the dev app's client_id (SHOPIFY_API_KEY) AND APP_ENV !== 'production', so
  // this column is provably never consulted by the public App-Store build.
  // null = no override (normal Shopify-derived plan).
  devForcedPlan     String? // "free" | "basic" | "pro" | "max" | null

  // Persistent per-shop trial-consumption marker. Set ONCE when a trial-bearing
  // subscription is verified ACTIVE (never optimistically at the mutation call,
  // never reset — not even on cancel). Bewusste Entscheidung: das Feld liegt auf
  // AISettings (shop-scoped) und wird damit bei shop/redact mitgelöscht. Das ist
  // gewollt — ein vollständig redacteter Shop, der echt neu installiert, darf
  // wieder einen Trial bekommen. Der Missbrauchspfad
  // (free → basic[Trial] → cancel → pro OHNE Uninstall/Redact) wird geschlossen,
  // weil die Zeile dabei erhalten bleibt. null = Trial noch nie konsumiert.
  trialConsumedAt   DateTime?

  // One-shot marker: set the first time a Pro/Max shop is shown the
  // theme-extension setup hint (infobox on app start). Without it the hint
  // would re-appear on every load. Like trialConsumedAt this lives on the
  // shop-scoped AISettings row, so it is cleared on shop/redact — a freshly
  // reinstalled Pro/Max shop may legitimately see the hint again.
  // null = hint not yet shown.
  extensionSetupHintShownAt DateTime?

  // Rate Limiting - Hugging Face
  hfMaxTokensPerMinute   Int? @default(1000000)
  hfMaxRequestsPerMinute Int? @default(100)

  // Rate Limiting - Gemini
  geminiMaxTokensPerMinute   Int? @default(1000000)
  geminiMaxRequestsPerMinute Int? @default(15)

  // Rate Limiting - Claude
  claudeMaxTokensPerMinute   Int? @default(40000)
  claudeMaxRequestsPerMinute Int? @default(5)

  // Rate Limiting - OpenAI
  openaiMaxTokensPerMinute   Int? @default(200000)
  openaiMaxRequestsPerMinute Int? @default(500)

  // Rate Limiting - Grok
  grokMaxTokensPerMinute   Int? @default(100000)
  grokMaxRequestsPerMinute Int? @default(60)

  // Rate Limiting - DeepSeek
  deepseekMaxTokensPerMinute   Int? @default(100000)
  deepseekMaxRequestsPerMinute Int? @default(60)

  // SEO Title suffix (shop name appended by Shopify theme)
  seoTitleSuffixEnabled Boolean @default(false)
  seoTitleSuffix        String? // e.g., " – Patis Universe"

  // Metafields settings tab: timestamp of the last product metafield-definition
  // scan. Also doubles as the lazy-backfill guard — when null, the loaders run
  // a one-time backfill of already-translatable definitions into
  // EnabledMetafieldDefinition so existing merchants' editors stay populated.
  metafieldsLastScanAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Product metafield definitions a merchant has explicitly enabled for the
// ContentPilot translation pipeline (Metafields settings tab). A metafield is
// shown/translated in the product editor only when its definition is BOTH
// translatable AND present here (decided design point 1). Removing a row hides
// the field from the editor again WITHOUT reverting the Shopify-side storefront
// access change (that would be destructive for the storefront/other tools).
model EnabledMetafieldDefinition {
  id        String @id @default(cuid())
  shop      String
  // Shopify GID of the MetafieldDefinition.
  definitionId String
  namespace String
  key       String
  // "PRODUCT" for now — column exists so later owner types can reuse the model.
  ownerType String @default("PRODUCT")
  // True when ContentPilot had to set the definition's storefront access to
  // PUBLIC_READ to make it translatable (i.e. it was not publicly accessible and
  // shop-owned). False for definitions that were already translatable/public
  // (incl. backfilled ones).
  patchedTranslatable Boolean  @default(false)
  enabledAt           DateTime @default(now())

  @@unique([shop, definitionId])
  @@index([shop, ownerType])
}

// Direct translations ("Direktübersetzungen"): merchant-managed storefront text
// that is NOT in translatable Shopify fields (e.g. third-party app widgets:
// review widgets, badges, page builders). A theme app embed replaces this text
// client-side using a merchant-curated dictionary. A first-class content type in
// the admin (consistent with products/collections/templates).
//
// An item is the IDENTITY (one rendered source string); its translations hang
// off it by FK (not by text), so editing the source text keeps the translations.
// Matching is exact on the normalized source — no fuzzy/partial matching.
// SEO caveat: client-side DOM replacement is not server-rendered.
model DirectTranslationItem {
  id         String   @id @default(cuid())
  shop       String
  // Stable hash of the normalized source string — identity of the item. The
  // storefront and admin both normalize identically so lookups are O(1).
  sourceHash String
  sourceText String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  translations DirectTranslation[]

  @@unique([shop, sourceHash])
  @@index([shop])
}

// One translation of a DirectTranslationItem into one locale. Cascade-deleted
// with its item; the source attaches translations by item FK, never by text.
model DirectTranslation {
  id         String   @id @default(cuid())
  itemId     String
  item       DirectTranslationItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  locale     String   // target language ISO, e.g. "fr"
  targetText String   @db.Text
  // "user" (manually entered / transferred) or "ai" (auto-translated).
  source     String   @default("user")
  updatedAt  DateTime @updatedAt

  // Market dimension — see ContentTranslation.marketId. "" = global.
  marketId   String   @default("")

  @@unique([itemId, locale, marketId])
}

// Untranslated strings discovered on the storefront (opt-in collector), pending
// merchant review. "Hinzufügen" promotes one to a DirectTranslationItem (and
// deletes the candidate); "Ablehnen" sets status `rejected` (kept, but never
// re-raises a notification). Strings that already exist as items are skipped.
model DirectTranslationCandidate {
  id          String   @id @default(cuid())
  shop        String
  sourceHash  String
  sourceText  String   @db.Text
  count       Int      @default(1)   // times seen across visitors/pages
  status      String   @default("new") // "new" | "rejected"
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([shop, sourceHash])
  @@index([shop, status])
  // Backs the FIFO-prune query (delete oldest when a shop's candidate count
  // exceeds MAX_CANDIDATES_PER_SHOP). Without this Postgres falls back to a
  // table scan + sort once a shop accumulates a few hundred candidates.
  @@index([shop, lastSeenAt])
}

// Per-shop settings + cache-busting version for the direct translation layer.
// NOTE: `enabled` is gone — the theme app embed is the on/off switch. Scope is
// gone — direct translations are global (apply on all pages).
model DirectTranslationSettings {
  shop      String   @id
  // Opt-in: when true, the storefront reports untranslated strings it renders
  // (heuristically filtered, capped) so the merchant can review them in the
  // admin. Off by default (privacy/noise). Never auto-applied.
  collect   Boolean  @default(false)
  // Opt-in: when true, the storefront walks AND replaces text even inside
  // elements marked `translate="no"`. 3rd-party review/widget apps (Judge.me
  // etc.) set that attribute to fence off browser auto-translate; for direct
  // translations the merchant is in control and usually wants those reached.
  ignoreTranslateNo Boolean @default(false)
  // Opt-in: when true, server-side language detection (franc) drops collected
  // candidates whose language matches the locale they were reported from —
  // i.e. strings that the storefront already serves in the right language and
  // therefore don't need a direct translation.
  filterByLanguage  Boolean @default(false)
  // Bumped on every dictionary change so the storefront cache invalidates.
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
}

model AIInstructions {
  id   String @id @default(cuid())
  shop String @unique

  // GENERAL - Writing Style Instructions (used by all AI generate/improve operations)
  writingStyleInstructions String? @db.Text
  // GENERAL - Format Instructions (used by the "Format" function)
  formatPreserveInstructions String? @db.Text
  // GENERAL - Translate Instructions (used by the "Translate" function)
  translateInstructions String? @db.Text

  // PRODUCTS - All fields available
  productTitleFormat             String? @db.Text
  productTitleInstructions       String? @db.Text
  productDescriptionFormat       String? @db.Text
  productDescriptionInstructions String? @db.Text
  productHandleFormat            String? @db.Text
  productHandleInstructions      String? @db.Text
  productSeoTitleFormat          String? @db.Text
  productSeoTitleInstructions    String? @db.Text
  productMetaDescFormat          String? @db.Text
  productMetaDescInstructions    String? @db.Text
  productAltTextFormat           String? @db.Text
  productAltTextInstructions     String? @db.Text

  // COLLECTIONS - All fields except altText
  collectionTitleFormat             String? @db.Text
  collectionTitleInstructions       String? @db.Text
  collectionDescriptionFormat       String? @db.Text
  collectionDescriptionInstructions String? @db.Text
  collectionHandleFormat            String? @db.Text
  collectionHandleInstructions      String? @db.Text
  collectionSeoTitleFormat          String? @db.Text
  collectionSeoTitleInstructions    String? @db.Text
  collectionMetaDescFormat          String? @db.Text
  collectionMetaDescInstructions    String? @db.Text

  // BLOGS/ARTICLES - All fields except altText
  blogTitleFormat             String? @db.Text
  blogTitleInstructions       String? @db.Text
  blogDescriptionFormat       String? @db.Text
  blogDescriptionInstructions String? @db.Text
  blogHandleFormat            String? @db.Text
  blogHandleInstructions      String? @db.Text
  blogSeoTitleFormat          String? @db.Text
  blogSeoTitleInstructions    String? @db.Text
  blogMetaDescFormat          String? @db.Text
  blogMetaDescInstructions    String? @db.Text

  // PAGES - Title, Description (body), Handle only (no SEO fields)
  pageTitleFormat             String? @db.Text
  pageTitleInstructions       String? @db.Text
  pageDescriptionFormat       String? @db.Text
  pageDescriptionInstructions String? @db.Text
  pageHandleFormat            String? @db.Text
  pageHandleInstructions      String? @db.Text
  pageSeoTitleFormat          String? @db.Text
  pageSeoTitleInstructions    String? @db.Text
  pageMetaDescFormat          String? @db.Text
  pageMetaDescInstructions    String? @db.Text

  // POLICIES - Only body/description is editable
  policyDescriptionFormat       String? @db.Text
  policyDescriptionInstructions String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id            String  @id @default(cuid())
  shop          String
  type          String // "translation", "aiGeneration", "bulkTranslation", "bulkAiGeneration"
  status        String  @default("pending") // "pending", "queued", "running", "completed", "failed", "cancelled"
  resourceType  String? // "product", "collection", "blog", "page"
  resourceId    String? // Shopify GID
  resourceTitle String? // For display purposes
  fieldType     String? // "title", "description", "handle", "seoTitle", "metaDescription", "all"
  targetLocale  String? // For translations
  progress      Int     @default(0) // 0-100
  total         Int? // Total number of items (for bulk operations)
  processed     Int     @default(0) // Number of processed items
  prompt        String? @db.Text // The AI prompt/request sent
  result        String? @db.Text // JSON string with results or error message
  error         String? @db.Text

  // Queue management
  queuePosition   Int? // Position in queue (null if not queued)
  retryCount      Int  @default(0) // Number of retries attempted
  estimatedTokens Int? // Estimated tokens for this task
  provider        String? // AI provider used (huggingface, gemini, claude, openai, grok, deepseek) - for recovery
  aiModel         String? // AI model name used (e.g., gpt-4o, claude-3-5-sonnet-20241022)

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  expiresAt   DateTime? // Automatic deletion timestamp (set to createdAt + 3 days)

  @@index([shop, status])
  @@index([shop, createdAt])
  @@index([shop, queuePosition])
  @@index([expiresAt])
  // R3-H5: /api/recently-completed-tasks polls every ~2s per open admin tab
  // with WHERE shop=? AND status IN(..) AND completedAt>=? ORDER BY
  // completedAt DESC. [shop,status] doesn't cover the completedAt range/sort,
  // forcing a range scan that does not scale to thousands of shops.
  @@index([shop, status, completedAt])
}

model Product {
  id               String  @id // Shopify GID (e.g., "gid://shopify/Product/123")
  shop             String
  title            String
  descriptionHtml  String? @db.Text
  handle           String
  status           String // "ACTIVE", "DRAFT", "ARCHIVED"
  productType      String? // Product type for categorization (e.g., "T-Shirt", "Shoes")
  seoTitle         String?
  seoDescription   String? @db.Text
  featuredImageUrl String?
  featuredImageAlt String?

  // Shopify Metadata
  shopifyUpdatedAt DateTime
  lastSyncedAt     DateTime @default(now())

  // Relations
  // NOTE: Translations are now stored in ContentTranslation table (polymorphic)
  images       ProductImage[]
  options      ProductOption[]
  metafields   ProductMetafield[]
  variants     ProductVariant[]

  @@unique([shop, id])
  @@index([shop])
  @@index([shop, status])
  @@index([lastSyncedAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url                String
  altText            String? // Primary locale alt-text
  mediaId            String? // Shopify Media ID (gid://shopify/MediaImage/123) for translations
  position           Int?
  altTextModifiedAt  DateTime? // Timestamp when user last modified alt-text (prevents webhook sync overwrite)
  altTextTranslations ProductImageAltTranslation[]

  // Atomic get-or-create keyed on (productId, mediaId) — prevents duplicate
  // ProductImage rows from concurrent alt-text applies. Postgres treats NULL
  // mediaId as distinct, so legacy rows without a Shopify media GID are unaffected.
  //
  // R4-H6 (assessed; intentionally NOT changed):
  //  • NULL-mediaId gap: NULL-distinctness is SQL-standard. It is acceptable
  //    here because every current write path (product sync, WebP, alt-text
  //    apply) always sets mediaId from a Shopify MediaImage GID — no path
  //    creates NULL-mediaId rows at volume; the only NULL rows are intentional
  //    legacy data. Closing the gap would require Postgres-15
  //    `NULLS NOT DISTINCT`, which could fail the migration on pre-existing
  //    duplicate-NULL rows and change semantics — disproportionate/uncertain.
  //  • non-CONCURRENT build: the backing migration
  //    (20260519100000_…) uses CREATE UNIQUE INDEX, which takes ACCESS
  //    EXCLUSIVE during the build. Prisma runs migrations in a transaction so
  //    CREATE INDEX CONCURRENTLY is not usable there. That migration is
  //    already applied (immutable history — must not be rewritten); on fresh
  //    DBs it builds on an empty table. FORWARD RULE: any future index on a
  //    large hot table must be added out-of-band CONCURRENTLY, not via an
  //    in-transaction Prisma migration, to avoid blocking boot/deploy.
  @@unique([productId, mediaId])
  @@index([productId])
}

model ProductImageAltTranslation {
  id      String       @id @default(cuid())
  imageId String
  image   ProductImage @relation(fields: [imageId], references: [id], onDelete: Cascade)

  locale  String // "en", "fr", "es", "it", etc.
  altText String @db.Text

  // Market dimension — see ContentTranslation.marketId. "" = global.
  marketId String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([imageId, locale, marketId])
  @@index([imageId])
  @@index([locale])
}

model ProductOption {
  id        String  @id // Shopify Option ID
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name     String
  position Int
  values   String @db.Text // JSON array
  linkedMetafieldKey String? // Metaobject type key when option is linked (e.g. "color")

  @@index([productId])
}

model ProductMetafield {
  id        String  @id // Shopify Metafield ID
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  namespace String
  key       String
  value     String @db.Text
  type      String

  @@index([productId])
}

model ProductVariant {
  id         String  @id           // numerische Shopify ID
  shopifyGid String  @unique       // gid://shopify/ProductVariant/...
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  title      String
  sku        String?
  imageKey   String?
  position   Int
  galleryJson String? @db.Text    // JSON: ["gid://shopify/File/...", ...]
  updatedAt  DateTime @updatedAt

  @@index([productId])
}

model OptionValueMemory {
  id          String   @id @default(cuid())
  shop        String
  optionValue String   // original display name, e.g. "Erdnuss"
  savedAs     String   // last saved key segment, e.g. "Peanut"
  updatedAt   DateTime @updatedAt

  @@unique([shop, optionValue])
  @@index([shop])
}

// Shop-weites Mapping fuer Felder mit Gruppierungs-Charakter (productType, perspektivisch vendor/tag).
// Mehrere Produkte mit demselben Quellwert muessen pro Zielsprache exakt eine gemeinsame Uebersetzung
// haben, sonst zerfaellt eine Kategorie in Google Merchant in mehrere.
model GroupedFieldTranslation {
  id              String   @id @default(cuid())
  shop            String
  fieldKey        String   // "productType" (zukuenftig: "vendor" | "tag")
  sourceLocale    String
  sourceValueNorm String   // trim + collapsed whitespace + lowercase (Lookup-Key)
  sourceValue     String   // kanonische Originalform (Casing des ersten Inserts)
  targetLocale    String
  translatedValue String
  source          String   @default("ai") // "ai" | "user" | "imported"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([shop, fieldKey, sourceLocale, sourceValueNorm, targetLocale])
  @@index([shop, fieldKey, sourceLocale])
}

model ImageManagerSettings {
  id            String  @id @default(cuid())
  shopId        String  @unique
  enabled       Boolean @default(true)
  firstImageBig Boolean @default(false)
  showAltTags   Boolean @default(false)
  autoAltText   Boolean @default(false)
  thumbSize     Int     @default(80)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WebhookLog {
  id        String   @id @default(cuid())
  shop      String
  topic     String // "products/create", "products/update", "products/delete"
  productId String?
  payload   String   @db.Text // Full webhook payload
  processed Boolean  @default(false)
  error     String?  @db.Text
  createdAt DateTime @default(now())

  @@index([shop, topic])
  @@index([processed])
  @@index([createdAt])
}

model WebhookRetry {
  id          String   @id @default(cuid())
  shop        String
  topic       String // Webhook topic (e.g., "products/update")
  payload     String   @db.Text // Full webhook payload as JSON
  attempt     Int      @default(0) // Current retry attempt number
  maxAttempts Int      @default(5) // Maximum retry attempts
  nextRetry   DateTime // When to attempt next retry
  lastError   String?  @db.Text // Last error message
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([shop])
  @@index([nextRetry])
  @@index([attempt])
}

// ============================================
// CONTENT MODELS (Collections, Blogs, Pages)
// ============================================

model Collection {
  id              String  @id // Shopify GID (e.g., "gid://shopify/Collection/123")
  shop            String
  title           String
  descriptionHtml String? @db.Text
  handle          String
  imageUrl        String? // Collection image URL
  imageAltText    String? // Collection image alt text
  seoTitle        String?
  seoDescription  String? @db.Text

  // Shopify Metadata
  shopifyUpdatedAt DateTime
  lastSyncedAt     DateTime @default(now())

  @@unique([shop, id])
  @@index([shop])
  @@index([lastSyncedAt])
}

model Article {
  id             String  @id // Shopify GID (e.g., "gid://shopify/Article/123")
  shop           String
  blogId         String // Shopify Blog GID
  blogTitle      String // For display purposes
  title          String
  body           String? @db.Text
  summary        String? @db.Text // Article excerpt/summary
  handle         String
  imageUrl       String? // Featured image URL
  imageAltText   String? // Featured image alt text
  seoTitle       String?
  seoDescription String? @db.Text

  // Shopify Metadata
  shopifyUpdatedAt DateTime
  lastSyncedAt     DateTime @default(now())

  @@unique([shop, id])
  @@index([shop])
  @@index([shop, blogId])
  @@index([lastSyncedAt])
}

model Page {
  id     String  @id // Shopify GID (e.g., "gid://shopify/Page/123")
  shop   String
  title  String
  body   String? @db.Text
  handle String

  // SEO fields (optional — only present if set in Shopify admin)
  seoTitle       String?
  seoDescription String? @db.Text

  // Shopify Metadata
  shopifyUpdatedAt DateTime
  lastSyncedAt     DateTime @default(now())

  @@unique([shop, id])
  @@index([shop])
  @@index([lastSyncedAt])
}

model ShopPolicy {
  id    String  @id // Shopify GID (e.g., "gid://shopify/ShopPolicy/123")
  shop  String
  title String
  body  String? @db.Text
  type  String // "CONTACT_INFORMATION", "LEGAL_NOTICE", "PRIVACY_POLICY", "REFUND_POLICY", "SHIPPING_POLICY", "TERMS_OF_SERVICE"
  url   String?

  // Shopify Metadata
  lastSyncedAt DateTime @default(now())

  @@unique([shop, id])
  @@index([shop])
  @@index([shop, type])
  @@index([lastSyncedAt])
}

model Menu {
  id     String @id // Shopify GID (e.g., "gid://shopify/Menu/123")
  shop   String
  title  String
  handle String
  items  Json   @db.JsonB // Store the entire menu items structure as JSON

  // Shopify Metadata
  lastSyncedAt DateTime @default(now())

  @@unique([shop, id])
  @@index([shop])
  @@index([lastSyncedAt])
}

model ContentTranslation {
  id String @id @default(cuid())

  // Polymorphic relation (can belong to Product, Collection, Article, Page, or ShopPolicy).
  // NO foreign key / ON DELETE CASCADE is possible: `resourceId` points at one
  // of several different parent tables depending on `resourceType`, which a
  // single SQL FK cannot express. Lifecycle is therefore enforced in app code:
  //   - GDPR/uninstall purge: redactShopData() in app/services/gdpr.service.ts
  //     deletes every row by `shop` (covered by a schema-drift guard test that
  //     fails if a shop-scoped model is added without a deleteMany there).
  //   - Per-resource deletes: callers must delete matching ContentTranslation
  //     rows by (shop, resourceId) — there is no DB safety net.
  // The explicit `shop` column below exists precisely to make these bulk
  // tenant-scoped deletes safe and indexable.
  resourceId   String // The GID of the parent resource
  resourceType String // "Product", "Collection", "Article", "Page", or "ShopPolicy"
  shop         String  // Defense-in-depth: explicit shop scope for multi-tenant isolation

  key    String // "title", "body_html", "body", "description", "handle", "meta_title", "meta_description"
  value  String  @db.Text
  locale String // "en", "fr", "es", "it", etc.
  digest String? // Shopify digest for updates

  // Market dimension (Shopify "Translate & Adapt"): "" = global (all markets,
  // legacy behaviour). Non-empty = gid://shopify/Market/<id>, a market-specific
  // override of the global translation for the same locale. Sentinel "" (not
  // NULL) so the composite unique key treats "one global row" deterministically
  // across DB engines — NULLs are considered distinct in unique constraints.
  marketId String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, resourceId, key, locale, marketId])
  // shop-prefixed so lookups stay within one tenant's index range instead of
  // scanning across all shops' rows for a (resourceId, locale) pair.
  @@index([shop, resourceId, locale, marketId])
  @@index([resourceType])
  @@index([locale])
  @@index([shop, resourceType])
  @@index([shop, resourceType, resourceId]) // For bulk joins in loaders - improves query performance by 40-60%
}

// ============================================
// THEME CONTENT MODELS (Background Sync)
// ============================================

model ThemeContent {
  id                  String   @id @default(cuid())
  shop                String
  resourceId          String // Shopify GID
  resourceType        String // "ONLINE_STORE_THEME", "ONLINE_STORE_THEME_JSON_TEMPLATE", etc.
  resourceTypeLabel   String // "Theme Content", "JSON Templates", etc.
  // Top-level content rubric this row belongs to. Lets the four content rubrics
  // (Theme, System, Online-Store-Extras, Selling-Plans) share the ThemeContent
  // table while each route/sync path scopes itself to its own domain.
  // "theme" | "system" | "online_store_extras" | "selling_plans"
  domain              String   @default("theme")
  groupId             String // "article", "collection", "product", "misc_cart", etc.
  groupName           String // "Article", "Collection", "Cart", etc.
  groupIcon           String // "📝", "📂", "🛒", etc.
  translatableContent Json // Array of translatable items with keys and values
  // True only for ONLINE_STORE_THEME_APP_EMBED rows that belong to OUR app
  // (block.type app-handle matches contentpilot). Our embeds are pure technical
  // selectors/config, so the editor locks them read-only in every locale; other
  // apps' embeds stay editable. Derived from settings_data.json at full sync.
  appEmbedOwned       Boolean  @default(false)
  lastSyncedAt        DateTime @default(now())

  @@unique([shop, resourceId, groupId])
  @@index([shop])
  @@index([shop, groupId])
  @@index([shop, domain])
  @@index([lastSyncedAt])
}

model ThemeTranslation {
  id         String  @id @default(cuid())
  shop       String
  resourceId String // Links to ThemeContent
  // Mirrors ThemeContent.domain (see there). Lets each rubric load/delete its
  // own translations without touching the others.
  domain     String  @default("theme")
  groupId    String // For faster queries
  key        String // Translation key
  value      String  @db.Text
  locale     String // "en", "fr", "es", "it", etc.
  outdated   Boolean @default(false)

  // Market dimension — see ContentTranslation.marketId. "" = global.
  marketId   String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Explicit map: the auto-generated name would exceed Postgres's 63-char limit.
  @@unique([shop, resourceId, groupId, key, locale, marketId], map: "ThemeTranslation_shop_res_group_key_locale_market_key")
  @@index([shop, resourceId, groupId])
  @@index([shop, groupId, locale]) // For efficient locale-specific group queries
  @@index([shop, domain])
  @@index([locale])
}

// ============================================
// METAOBJECT MODELS (Background Sync)
// ============================================

model MetaobjectDefinition {
  id              String @id // Shopify GID (e.g., "gid://shopify/MetaobjectDefinition/123")
  shop            String
  type            String // Metaobject type identifier (e.g., "size_guide", "product_spec")
  name            String // Display name
  description     String? @db.Text
  fieldDefinitions Json // Array of field definitions with keys and types

  lastSyncedAt DateTime @default(now())

  @@unique([shop, id])
  @@unique([shop, type])
  @@index([shop])
  @@index([lastSyncedAt])
}

model Metaobject {
  id              String  @id // Shopify GID (e.g., "gid://shopify/Metaobject/123")
  shop            String
  type            String // Links to MetaobjectDefinition.type
  handle          String
  displayName     String // Primary locale display name
  fields          Json // Array of field values {key, value, type}

  // Shopify Metadata
  shopifyUpdatedAt DateTime
  lastSyncedAt     DateTime @default(now())

  @@unique([shop, id])
  @@index([shop])
  @@index([shop, type])
  @@index([lastSyncedAt])
}

model MetaobjectTranslation {
  id           String  @id @default(cuid())
  shop         String
  metaobjectId String // Shopify GID of the metaobject
  type         String // Metaobject type (for grouping)
  key          String // Field key (e.g., "display_name", "name", "label")
  value        String  @db.Text
  locale       String // "en", "fr", "es", "it", etc.
  outdated     Boolean @default(false)

  // Market dimension — see ContentTranslation.marketId. "" = global.
  marketId     String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, metaobjectId, key, locale, marketId])
  @@index([shop, metaobjectId])
  @@index([shop, type, locale]) // For efficient type-specific locale queries
  @@index([locale])
}

/// Templates for bulk alt text generation with variable placeholders (e.g. {Farbe}).
model AltTextTemplate {
  id            String   @id @default(cuid())
  shop          String
  productId     String
  position      Int      // image position (1-based: 1 = main image, 2 = first gallery, …); legacy rows may use 0-based
  positionLabel String?  // optional user-defined label, e.g. "Main Image"
  locale        String   // "de", "en", "fr", etc.
  template      String   @db.Text // e.g. "Eleganter {Farbe} Blumentopf"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([shop, productId, position, locale])
  @@index([shop, productId])
}

/// Persistent audit trail for GDPR compliance requests.
/// Entries are retained for 3 years (Art. 5(2) GDPR accountability) and are
/// deliberately NOT deleted on shop/redact. The 3-year upper bound is enforced
/// by GdprAuditLogCleanupService (src/services/gdpr-audit-cleanup.service.ts;
/// standalone mirror gdpr-audit-cleanup.service.js, started from server.js),
/// which runs daily and deletes only rows where requestedAt < now − 3 years.
model GdprAuditLog {
  id              String   @id @default(cuid())
  shop            String
  requestType     String   // "data_request" | "customer_redact" | "shop_redact"
  customerId      BigInt?
  customerEmail   String?
  status          String   // "completed" | "failed"
  dataExported    String?  @db.Text // R5-G1: FULL data_request export JSON (≤1 MB), surfaced in admin
  error           String?  @db.Text
  // R5-G4: Shopify X-Shopify-Webhook-Id — correlates redelivered (non-2xx
  // retried, up to ~48h) compliance attempts in this append-only trail.
  webhookId       String?
  requestedAt     DateTime @default(now())
  completedAt     DateTime @default(now())

  @@index([shop])
  @@index([shop, requestType])
  @@index([requestedAt])
  @@index([webhookId])
}

/// Tracks per-shop install lifecycle so the 30-day reaper has a reliable
/// "inactive since" anchor. `uninstalledAt` is set by the APP_UNINSTALLED
/// webhook and cleared (set null) on every (re)install via afterAuth.
model ShopInstallState {
  shop                   String    @id
  uninstalledAt          DateTime?
  // Set ONCE when the initial full sync (incl. product translations) completes
  // successfully (api.sync-all-stream). Onboarding (app._index) and the
  // sync-stream products gate key off THIS marker, not db.product.count — a
  // Remix prefetch of the products loader populates db.product before the
  // initial sync runs, so a count-based gate would skip translations forever.
  // null = initial sync not yet completed (run onboarding). Deleted together
  // with products on full GDPR wipe (gdpr.service) → reinstall re-onboards.
  initialSyncCompletedAt DateTime?
  // Server-side initial-sync progress, written (throttled) by the sync scheduler
  // so the persistent onboarding banner can poll it without an open SSE stream.
  // initialSyncStartedAt anchors the 3h bypass cap (process-restart safe).
  // initialSyncForceRequested is set by the Settings "Sync Products" re-sync
  // trigger and consumed (force-delete + full re-pull) by the scheduler.
  initialSyncStartedAt      DateTime?
  initialSyncPhase          String?
  initialSyncPercent        Int?
  initialSyncStats          Json?
  initialSyncError          String?
  initialSyncForceRequested Boolean   @default(false)
  updatedAt              DateTime  @updatedAt

  @@index([uninstalledAt])
}

// Rolling monthly counter for billable image operations (Bulk-Upload + WebP
// conversion). One row per (shop, period). Usage data only — NOT entitlement
// data, so it is intentionally absent from getSyncScope / planCacheCleanup;
// the quota is enforced lazily at the upload/convert routes. See
// docs/ROADMAP.md §Limit-Review Befund 3.
model ImageOperationCounter {
  id        String   @id @default(cuid())
  shop      String
  period    String // "YYYY-MM" (UTC)
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([shop, period])
  @@index([shop])
}
