{%- if product != blank -%}

<script type="application/json" id="cp-embed-data-{{ block.id }}">
  {
    {%- for variant in product.variants -%}
      {%- assign vg = variant.metafields.custom.variant_gallery -%}
      {%- assign cp_order_mf = variant.metafields.custom.variant_gallery_order -%}
      {%- assign cp_models_mf = variant.metafields.custom.variant_3d_models -%}
      {%- assign cp_previews_mf = variant.metafields.custom.variant_3d_previews -%}
      "{{ variant.id }}": [
        {%- assign cp_has_any = false -%}
        {%- assign cp_seen_file_ids = ',' -%}
        {%- assign cp_seen_urls = ',' -%}
        {%- assign cp_seen_models = ',' -%}
        
        {%- assign cp_has_vg     = false -%}
        {%- assign cp_has_models = false -%}
        {%- if vg != blank and vg.value != blank -%}{%- assign cp_has_vg = true -%}{%- endif -%}
        {%- if cp_models_mf != blank and cp_models_mf.value != blank -%}{%- assign cp_has_models = true -%}{%- endif -%}
        
        {%- if cp_order_mf != blank and cp_order_mf.value != blank -%}
          {%- if variant.featured_image != blank -%}
            {%- assign vfi = variant.featured_image -%}
            {%- assign vfi_id_str = vfi.id | append: '' -%}
            {%- assign cp_seen_file_ids = cp_seen_file_ids | append: vfi_id_str | append: ',' -%}
            {
              "type":     "image",
              "src_400":  {{ vfi | image_url: width: 400  | json }},
              "src_800":  {{ vfi | image_url: width: 800  | json }},
              "src_1200": {{ vfi | image_url: width: 1200 | json }},
              "thumb":    {{ vfi | image_url: width: 160  | json }},
              "w":        {{ vfi.width  | json }},
              "h":        {{ vfi.height | json }},
              "alt":      {{ variant.title | json | replace: "<", "\u003c" | replace: ">", "\u003e" }}
            }
            {%- assign cp_has_any = true -%}
          {%- endif -%}
          {%- for entry in cp_order_mf.value -%}
            {%- if entry.kind == 'file' -%}
              {%- assign entry_val = entry.value | append: '' -%}
              {%- assign needle = ',' | append: entry_val | append: ',' -%}
              {%- if cp_seen_file_ids contains needle -%}{%- continue -%}{%- endif -%}
              {%- for item in vg.value -%}
                {%- assign item_id_str = item.id | append: '' -%}
                {%- if item_id_str == entry_val -%}
                  {%- assign cp_seen_file_ids = cp_seen_file_ids | append: entry_val | append: ',' -%}
                  {%- if item.media_type == 'image' -%}
                    {%- assign cp_src = item | image_url: width: 800 -%}
                    {%- if cp_src != blank -%}
                      {%- if cp_has_any %},{% endif -%}
                      {%- assign cp_w = item.preview_image.width  | default: item.width -%}
                      {%- assign cp_h = item.preview_image.height | default: item.height -%}
                      {
                        "type":     "image",
                        "src_400":  {{ item | image_url: width: 400  | json }},
                        "src_800":  {{ cp_src | json }},
                        "src_1200": {{ item | image_url: width: 1200 | json }},
                        "thumb":    {{ item | image_url: width: 160  | json }},
                        "w":        {{ cp_w | json }},
                        "h":        {{ cp_h | json }},
                        "alt":      {{ item.alt | default: variant.title | json | replace: "<", "\u003c" | replace: ">", "\u003e" }}
                      }
                      {%- assign cp_has_any = true -%}
                    {%- endif -%}
                  {%- elsif item.media_type == 'video' -%}
                    {%- if item.preview_image != blank and item.sources.size > 0 -%}
                      {%- if cp_has_any %},{% endif -%}
                      {%- assign cp_pi = item.preview_image -%}
                      {
                        "type":   "video",
                        "thumb":  {{ cp_pi | image_url: width: 160  | json }},
                        "poster": {{ cp_pi | image_url: width: 1200 | json }},
                        "w":      {{ cp_pi.width  | json }},
                        "h":      {{ cp_pi.height | json }},
                        "alt":    {{ item.alt | default: variant.title | json | replace: "<", "\u003c" | replace: ">", "\u003e" }},
                        "sources": [
                          {%- for src in item.sources -%}
                            {%- unless forloop.first %},{% endunless -%}
                            {"src": {{ src.url | json }}, "mime": {{ src.mime_type | json }}}
                          {%- endfor -%}
                        ]
                      }
                      {%- assign cp_has_any = true -%}
                    {%- endif -%}
                  {%- endif -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}
            {%- elsif entry.kind == 'url' -%}
              {%- assign entry_val = entry.value | append: '' -%}
              
              {%- assign url_token = entry_val | url_encode -%}
              {%- assign url_needle = ',' | append: url_token | append: ',' -%}
              {%- if cp_seen_urls contains url_needle -%}{%- continue -%}{%- endif -%}
              {%- assign cp_seen_urls = cp_seen_urls | append: url_token | append: ',' -%}
              {%- assign cp_url = entry_val | strip -%}
              {%- assign cp_ev_host = blank -%}
              {%- assign cp_ev_id = blank -%}
              {%- if cp_url contains 'youtube.com/watch' and cp_url contains 'v=' -%}
                {%- assign cp_ev_host = 'youtube' -%}
                {%- assign cp_ev_tail = cp_url | split: 'v=' | last -%}
                {%- assign cp_ev_id = cp_ev_tail | split: '&' | first | split: '#' | first -%}
              {%- elsif cp_url contains 'youtu.be/' -%}
                {%- assign cp_ev_host = 'youtube' -%}
                {%- assign cp_ev_tail = cp_url | split: 'youtu.be/' | last -%}
                {%- assign cp_ev_id = cp_ev_tail | split: '?' | first | split: '/' | first | split: '#' | first -%}
              {%- elsif cp_url contains 'youtube.com/embed/' -%}
                {%- assign cp_ev_host = 'youtube' -%}
                {%- assign cp_ev_tail = cp_url | split: 'youtube.com/embed/' | last -%}
                {%- assign cp_ev_id = cp_ev_tail | split: '?' | first | split: '/' | first | split: '#' | first -%}
              {%- elsif cp_url contains 'youtube.com/shorts/' -%}
                {%- assign cp_ev_host = 'youtube' -%}
                {%- assign cp_ev_tail = cp_url | split: 'youtube.com/shorts/' | last -%}
                {%- assign cp_ev_id = cp_ev_tail | split: '?' | first | split: '/' | first | split: '#' | first -%}
              {%- elsif cp_url contains 'vimeo.com/' -%}
                {%- assign cp_ev_host = 'vimeo' -%}
                {%- assign cp_ev_tail = cp_url | split: 'vimeo.com/' | last -%}
                {%- if cp_ev_tail contains 'video/' -%}
                  {%- assign cp_ev_tail = cp_ev_tail | split: 'video/' | last -%}
                {%- endif -%}
                {%- assign cp_ev_id = cp_ev_tail | split: '?' | first | split: '/' | first | split: '#' | first -%}
              {%- endif -%}
              {%- if cp_ev_host != blank and cp_ev_id != blank -%}
                {%- if cp_ev_host == 'youtube' -%}
                  {%- assign cp_ev_thumb = 'https://img.youtube.com/vi/' | append: cp_ev_id | append: '/hqdefault.jpg' -%}
                {%- else -%}
                  {%- assign cp_ev_thumb = '' -%}
                {%- endif -%}
                {%- if cp_has_any %},{% endif -%}
                {
                  "type":        "external_video",
                  "thumb":       {{ cp_ev_thumb | json }},
                  "poster":      {{ cp_ev_thumb | json }},
                  "w":           {{ 0 | json }},
                  "h":           {{ 0 | json }},
                  "alt":         {{ variant.title | json | replace: "<", "\u003c" | replace: ">", "\u003e" }},
                  "host":        {{ cp_ev_host | json }},
                  "external_id": {{ cp_ev_id | json }}
                }
                {%- assign cp_has_any = true -%}
              {%- endif -%}
            {%- elsif entry.kind == 'model' -%}
              {%- assign entry_val = entry.value | append: '' -%}
              
              {%- assign model_token = entry_val | url_encode -%}
              {%- assign model_needle = ',' | append: model_token | append: ',' -%}
              {%- if cp_seen_models contains model_needle -%}{%- continue -%}{%- endif -%}
              {%- assign cp_seen_models = cp_seen_models | append: model_token | append: ',' -%}
              {%- assign cp_model_url = entry_val | strip -%}
              
              {%- assign cp_model_preview = '' -%}
              {%- if cp_previews_mf != blank and cp_previews_mf.value != blank and cp_models_mf != blank and cp_models_mf.value != blank -%}
                {%- for cp_m_url in cp_models_mf.value -%}
                  {%- if cp_m_url == cp_model_url -%}
                    {%- assign cp_model_preview = cp_previews_mf.value[forloop.index0] | default: '' -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
              {%- if cp_model_url != blank -%}
                {%- if cp_has_any %},{% endif -%}
                {
                  "type":      "model",
                  "thumb":     {{ cp_model_preview | json }},
                  "poster":    {{ cp_model_preview | json }},
                  "w":         800,
                  "h":         800,
                  "alt":       {{ variant.title | json | replace: "<", "\u003c" | replace: ">", "\u003e" }},
                  "model_src": {{ cp_model_url | json }}
                }
                {%- assign cp_has_any = true -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          
          {%- if vg != blank and vg.value != blank -%}
            {%- for item in vg.value -%}
              {%- assign item_id_str = item.id | append: '' -%}
              {%- assign tail_needle = ',' | append: item_id_str | append: ',' -%}
              {%- if cp_seen_file_ids contains tail_needle -%}{%- continue -%}{%- endif -%}
              {%- assign cp_seen_file_ids = cp_seen_file_ids | append: item_id_str | append: ',' -%}
              {%- if item.media_type == 'image' -%}
                {%- assign cp_src = item | image_url: width: 800 -%}
                {%- if cp_src != blank -%}
                  {%- if cp_has_any %},{% endif -%}
                  {%- assign cp_w = item.preview_image.width  | default: item.width -%}
                  {%- assign cp_h = item.preview_image.height | default: item.height -%}
                  {
                    "type":     "image",
                    "src_400":  {{ item | image_url: width: 400  | json }},
                    "src_800":  {{ cp_src | json }},
                    "src_1200": {{ item | image_url: width: 1200 | json }},
                    "thumb":    {{ item | image_url: width: 160  | json }},
                    "w":        {{ cp_w | json }},
                    "h":        {{ cp_h | json }},
                    "alt":      {{ item.alt | default: variant.title | json | replace: "<", "\u003c" | replace: ">", "\u003e" }}
                  }
                  {%- assign cp_has_any = true -%}
                {%- endif -%}
              {%- elsif item.media_type == 'video' -%}
                {%- if item.preview_image != blank and item.sources.size > 0 -%}
                  {%- if cp_has_any %},{% endif -%}
                  {%- assign cp_pi = item.preview_image -%}
                  {
                    "type":   "video",
                    "thumb":  {{ cp_pi | image_url: width: 160  | json }},
                    "poster": {{ cp_pi | image_url: width: 1200 | json }},
                    "w":      {{ cp_pi.width  | json }},
                    "h":      {{ cp_pi.height | json }},
                    "alt":    {{ item.alt | default: variant.title | json | replace: "<", "\u003c" | replace: ">", "\u003e" }},
                    "sources": [
                      {%- for src in item.sources -%}
                        {%- unless forloop.first %},{% endunless -%}
                        {"src": {{ src.url | json }}, "mime": {{ src.mime_type | json }}}
                      {%- endfor -%}
                    ]
                  }
                  {%- assign cp_has_any = true -%}
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          {%- assign cp_tail_extvids = variant.metafields.custom.variant_external_videos -%}
          {%- if cp_tail_extvids != blank and cp_tail_extvids.value != blank -%}
            {%- for cp_url_raw in cp_tail_extvids.value -%}
              {%- assign cp_url = cp_url_raw | strip -%}
              {%- assign url_tail_token = cp_url | url_encode -%}
              {%- assign url_tail_needle = ',' | append: url_tail_token | append: ',' -%}
              {%- if cp_seen_urls contains url_tail_needle -%}{%- continue -%}{%- endif -%}
              {%- assign cp_seen_urls = cp_seen_urls | append: url_tail_token | append: ',' -%}
              {%- assign cp_ev_host = blank -%}
              {%- assign cp_ev_id = blank -%}
              {%- if cp_url contains 'youtube.com/watch' and cp_url contains 'v=' -%}
                {%- assign cp_ev_host = 'youtube' -%}
                {%- assign cp_ev_tail = cp_url | split: 'v=' | last -%}
                {%- assign cp_ev_id = cp_ev_tail | split: '&' | first | split: '#' | first -%}
              {%- elsif cp_url contains 'youtu.be/' -%}
                {%- assign cp_ev_host = 'youtube' -%}
                {%- assign cp_ev_tail = cp_url | split: 'youtu.be/' | last -%}
                {%- assign cp_ev_id = cp_ev_tail | split: '?' | first | split: '/' | first | split: '#' | first -%}
              {%- elsif cp_url contains 'vimeo.com/' -%}
                {%- assign cp_ev_host = 'vimeo' -%}
                {%- assign cp_ev_tail = cp_url | split: 'vimeo.com/' | last -%}
                {%- if cp_ev_tail contains 'video/' -%}
                  {%- assign cp_ev_tail = cp_ev_tail | split: 'video/' | last -%}
                {%- endif -%}
                {%- assign cp_ev_id = cp_ev_tail | split: '?' | first | split: '/' | first | split: '#' | first -%}
              {%- endif -%}
              {%- if cp_ev_host != blank and cp_ev_id != blank -%}
                {%- if cp_ev_host == 'youtube' -%}
                  {%- assign cp_ev_thumb = 'https://img.youtube.com/vi/' | append: cp_ev_id | append: '/hqdefault.jpg' -%}
                {%- else -%}
                  {%- assign cp_ev_thumb = '' -%}
                {%- endif -%}
                {%- if cp_has_any %},{% endif -%}
                {
                  "type":        "external_video",
                  "thumb":       {{ cp_ev_thumb | json }},
                  "poster":      {{ cp_ev_thumb | json }},
                  "w":           {{ 0 | json }},
                  "h":           {{ 0 | json }},
                  "alt":         {{ variant.title | json | replace: "<", "\u003c" | replace: ">", "\u003e" }},
                  "host":        {{ cp_ev_host | json }},
                  "external_id": {{ cp_ev_id | json }}
                }
                {%- assign cp_has_any = true -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          
          {%- if cp_models_mf != blank and cp_models_mf.value != blank -%}
            {%- for cp_model_url_raw in cp_models_mf.value -%}
              {%- assign cp_model_url = cp_model_url_raw | strip -%}
              {%- assign model_tail_token = cp_model_url | url_encode -%}
              {%- assign model_tail_needle = ',' | append: model_tail_token | append: ',' -%}
              {%- if cp_seen_models contains model_tail_needle -%}{%- continue -%}{%- endif -%}
              {%- assign cp_seen_models = cp_seen_models | append: model_tail_token | append: ',' -%}
              
              {%- assign cp_model_preview = '' -%}
              {%- if cp_previews_mf != blank and cp_previews_mf.value != blank -%}
                {%- assign cp_model_preview = cp_previews_mf.value[forloop.index0] | default: '' -%}
              {%- endif -%}
              {%- if cp_model_url != blank -%}
                {%- if cp_has_any %},{% endif -%}
                {
                  "type":      "model",
                  "thumb":     {{ cp_model_preview | json }},
                  "poster":    {{ cp_model_preview | json }},
                  "w":         800,
                  "h":         800,
                  "alt":       {{ variant.title | json | replace: "<", "\u003c" | replace: ">", "\u003e" }},
                  "model_src": {{ cp_model_url | json }}
                }
                {%- assign cp_has_any = true -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        
        {%- elsif cp_has_vg or cp_has_models -%}
          {%- if variant.featured_image != blank -%}
            {%- assign vfi = variant.featured_image -%}
            {
              "type":     "image",
              "src_400":  {{ vfi | image_url: width: 400  | json }},
              "src_800":  {{ vfi | image_url: width: 800  | json }},
              "src_1200": {{ vfi | image_url: width: 1200 | json }},
              "thumb":    {{ vfi | image_url: width: 160  | json }},
              "w":        {{ vfi.width  | json }},
              "h":        {{ vfi.height | json }},
              "alt":      {{ variant.title | json | replace: "<", "\u003c" | replace: ">", "\u003e" }}
            }
            {%- assign cp_has_any = true -%}
          {%- endif -%}
          
          {%- for item in vg.value -%}
            {%- if item.media_type == 'image' -%}
              {%- assign cp_src = item | image_url: width: 800 -%}
              {%- if cp_src != blank -%}
                {%- if cp_has_any %},{% endif -%}
                {%- assign cp_w = item.preview_image.width  | default: item.width -%}
                {%- assign cp_h = item.preview_image.height | default: item.height -%}
                {
                  "type":     "image",
                  "src_400":  {{ item | image_url: width: 400  | json }},
                  "src_800":  {{ cp_src | json }},
                  "src_1200": {{ item | image_url: width: 1200 | json }},
                  "thumb":    {{ item | image_url: width: 160  | json }},
                  "w":        {{ cp_w | json }},
                  "h":        {{ cp_h | json }},
                  "alt":      {{ item.alt | default: variant.title | json | replace: "<", "\u003c" | replace: ">", "\u003e" }}
                }
                {%- assign cp_has_any = true -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          {%- for item in vg.value -%}
            {%- if item.media_type == 'video' -%}
              {%- if item.preview_image != blank and item.sources.size > 0 -%}
                {%- if cp_has_any %},{% endif -%}
                {%- assign cp_pi = item.preview_image -%}
                {
                  "type":   "video",
                  "thumb":  {{ cp_pi | image_url: width: 160  | json }},
                  "poster": {{ cp_pi | image_url: width: 1200 | json }},
                  "w":      {{ cp_pi.width  | json }},
                  "h":      {{ cp_pi.height | json }},
                  "alt":    {{ item.alt | default: variant.title | json | replace: "<", "\u003c" | replace: ">", "\u003e" }},
                  "sources": [
                    {%- for src in item.sources -%}
                      {%- unless forloop.first %},{% endunless -%}
                      {"src": {{ src.url | json }}, "mime": {{ src.mime_type | json }}}
                    {%- endfor -%}
                  ]
                }
                {%- assign cp_has_any = true -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          
          {%- assign cp_extvids = variant.metafields.custom.variant_external_videos -%}
          {%- if cp_extvids != blank and cp_extvids.value != blank -%}
            {%- for cp_url_raw in cp_extvids.value -%}
              {%- assign cp_url = cp_url_raw | strip -%}
              {%- assign cp_ev_host = blank -%}
              {%- assign cp_ev_id = blank -%}
              {%- if cp_url contains 'youtube.com/watch' and cp_url contains 'v=' -%}
                {%- assign cp_ev_host = 'youtube' -%}
                {%- assign cp_ev_tail = cp_url | split: 'v=' | last -%}
                {%- assign cp_ev_id = cp_ev_tail | split: '&' | first | split: '#' | first -%}
              {%- elsif cp_url contains 'youtu.be/' -%}
                {%- assign cp_ev_host = 'youtube' -%}
                {%- assign cp_ev_tail = cp_url | split: 'youtu.be/' | last -%}
                {%- assign cp_ev_id = cp_ev_tail | split: '?' | first | split: '/' | first | split: '#' | first -%}
              {%- elsif cp_url contains 'youtube.com/embed/' -%}
                {%- assign cp_ev_host = 'youtube' -%}
                {%- assign cp_ev_tail = cp_url | split: 'youtube.com/embed/' | last -%}
                {%- assign cp_ev_id = cp_ev_tail | split: '?' | first | split: '/' | first | split: '#' | first -%}
              {%- elsif cp_url contains 'youtube.com/shorts/' -%}
                {%- assign cp_ev_host = 'youtube' -%}
                {%- assign cp_ev_tail = cp_url | split: 'youtube.com/shorts/' | last -%}
                {%- assign cp_ev_id = cp_ev_tail | split: '?' | first | split: '/' | first | split: '#' | first -%}
              {%- elsif cp_url contains 'vimeo.com/' -%}
                {%- assign cp_ev_host = 'vimeo' -%}
                {%- assign cp_ev_tail = cp_url | split: 'vimeo.com/' | last -%}
                {%- if cp_ev_tail contains 'video/' -%}
                  {%- assign cp_ev_tail = cp_ev_tail | split: 'video/' | last -%}
                {%- endif -%}
                {%- assign cp_ev_id = cp_ev_tail | split: '?' | first | split: '/' | first | split: '#' | first -%}
              {%- endif -%}
              {%- if cp_ev_host != blank and cp_ev_id != blank -%}
                {%- if cp_ev_host == 'youtube' -%}
                  {%- assign cp_ev_thumb = 'https://img.youtube.com/vi/' | append: cp_ev_id | append: '/hqdefault.jpg' -%}
                {%- else -%}
                  {%- assign cp_ev_thumb = '' -%}
                {%- endif -%}
                {%- if cp_has_any %},{% endif -%}
                {
                  "type":        "external_video",
                  "thumb":       {{ cp_ev_thumb | json }},
                  "poster":      {{ cp_ev_thumb | json }},
                  "w":           {{ 0 | json }},
                  "h":           {{ 0 | json }},
                  "alt":         {{ variant.title | json | replace: "<", "\u003c" | replace: ">", "\u003e" }},
                  "host":        {{ cp_ev_host | json }},
                  "external_id": {{ cp_ev_id | json }}
                }
                {%- assign cp_has_any = true -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          
          {%- if cp_models_mf != blank and cp_models_mf.value != blank -%}
            {%- for cp_model_url_raw in cp_models_mf.value -%}
              {%- assign cp_model_url = cp_model_url_raw | strip -%}
              
              {%- assign cp_model_preview = '' -%}
              {%- if cp_previews_mf != blank and cp_previews_mf.value != blank -%}
                {%- assign cp_model_preview = cp_previews_mf.value[forloop.index0] | default: '' -%}
              {%- endif -%}
              {%- if cp_model_url != blank -%}
                {%- if cp_has_any %},{% endif -%}
                {
                  "type":      "model",
                  "thumb":     {{ cp_model_preview | json }},
                  "poster":    {{ cp_model_preview | json }},
                  "w":         800,
                  "h":         800,
                  "alt":       {{ variant.title | json | replace: "<", "\u003c" | replace: ">", "\u003e" }},
                  "model_src": {{ cp_model_url | json }}
                }
                {%- assign cp_has_any = true -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endif -%}
        
        {%- unless cp_has_any -%}
          {%- assign cp_vfi_id = blank -%}
          {%- if variant.featured_image != blank -%}
            {%- assign vfi = variant.featured_image -%}
            {
              "type":     "image",
              "src_400":  {{ vfi | image_url: width: 400  | json }},
              "src_800":  {{ vfi | image_url: width: 800  | json }},
              "src_1200": {{ vfi | image_url: width: 1200 | json }},
              "thumb":    {{ vfi | image_url: width: 160  | json }},
              "w":        {{ vfi.width  | json }},
              "h":        {{ vfi.height | json }},
              "alt":      {{ variant.title | json | replace: "<", "\u003c" | replace: ">", "\u003e" }}
            }
            {%- assign cp_has_any = true -%}
            {%- assign cp_vfi_id = vfi.id -%}
          {%- endif -%}
          {%- for media in product.media -%}
            {%- if media.id != cp_vfi_id -%}
              {%- if media.media_type == 'image' -%}
                {%- assign cp_src = media | image_url: width: 800 -%}
                {%- if cp_src != blank -%}
                  {%- if cp_has_any %},{% endif -%}
                  {%- assign cp_w = media.preview_image.width  | default: media.width -%}
                  {%- assign cp_h = media.preview_image.height | default: media.height -%}
                  {
                    "type":     "image",
                    "src_400":  {{ media | image_url: width: 400  | json }},
                    "src_800":  {{ cp_src | json }},
                    "src_1200": {{ media | image_url: width: 1200 | json }},
                    "thumb":    {{ media | image_url: width: 160  | json }},
                    "w":        {{ cp_w | json }},
                    "h":        {{ cp_h | json }},
                    "alt":      {{ media.alt | default: product.title | json | replace: "<", "\u003c" | replace: ">", "\u003e" }}
                  }
                  {%- assign cp_has_any = true -%}
                {%- endif -%}
              {%- elsif media.media_type == 'video' -%}
                {%- if media.preview_image != blank and media.sources.size > 0 -%}
                  {%- if cp_has_any %},{% endif -%}
                  {%- assign cp_pi = media.preview_image -%}
                  {
                    "type":   "video",
                    "thumb":  {{ cp_pi | image_url: width: 160  | json }},
                    "poster": {{ cp_pi | image_url: width: 1200 | json }},
                    "w":      {{ cp_pi.width  | json }},
                    "h":      {{ cp_pi.height | json }},
                    "alt":    {{ media.alt | default: product.title | json | replace: "<", "\u003c" | replace: ">", "\u003e" }},
                    "sources": [
                      {%- for src in media.sources -%}
                        {%- unless forloop.first %},{% endunless -%}
                        {"src": {{ src.url | json }}, "mime": {{ src.mime_type | json }}}
                      {%- endfor -%}
                    ]
                  }
                  {%- assign cp_has_any = true -%}
                {%- endif -%}
              {%- elsif media.media_type == 'external_video' -%}
                {%- if media.preview_image != blank -%}
                  {%- if cp_has_any %},{% endif -%}
                  {%- assign cp_pi = media.preview_image -%}
                  {
                    "type":        "external_video",
                    "thumb":       {{ cp_pi | image_url: width: 160  | json }},
                    "poster":      {{ cp_pi | image_url: width: 1200 | json }},
                    "w":           {{ cp_pi.width  | json }},
                    "h":           {{ cp_pi.height | json }},
                    "alt":         {{ media.alt | default: product.title | json | replace: "<", "\u003c" | replace: ">", "\u003e" }},
                    "host":        {{ media.host | json }},
                    "external_id": {{ media.external_id | json }}
                  }
                  {%- assign cp_has_any = true -%}
                {%- endif -%}
              {%- elsif media.media_type == 'model' -%}
                {%- if media.preview_image != blank -%}
                  {%- assign cp_glb = blank -%}
                  {%- for src in media.sources -%}
                    {%- assign cp_fmt = src.format | downcase -%}
                    {%- if cp_fmt == 'glb' and cp_glb == blank -%}{%- assign cp_glb = src.url -%}{%- endif -%}
                  {%- endfor -%}
                  {%- if cp_glb != blank -%}
                    {%- if cp_has_any %},{% endif -%}
                    {%- assign cp_pi = media.preview_image -%}
                    {
                      "type":      "model",
                      "thumb":     {{ cp_pi | image_url: width: 160  | json }},
                      "poster":    {{ cp_pi | image_url: width: 1200 | json }},
                      "w":         {{ cp_pi.width  | json }},
                      "h":         {{ cp_pi.height | json }},
                      "alt":       {{ media.alt | default: product.title | json | replace: "<", "\u003c" | replace: ">", "\u003e" }},
                      "model_src": {{ cp_glb | json }}
                    }
                    {%- assign cp_has_any = true -%}
                  {%- endif -%}
                {%- endif -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endunless -%}
      ]{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  }
</script>

<script>
  (function () {
    try {
      var el = document.getElementById('cp-embed-data-{{ block.id }}');
      if (!el) return;
      var data = JSON.parse(el.textContent);
      var id = null;
      try { id = new URL(window.location.href).searchParams.get('variant'); } catch (e) {}
      if (!id) id = {{ product.selected_or_first_available_variant.id | json }};
      if (id == null) return;
      var imgs = data[String(id)];
      if (!(imgs && imgs.length)) return;
      document.documentElement.classList.add('cp-vg-prehide');
      window.__cpVgFouc = window.__cpVgFouc || {};
      window.__cpVgFouc.prehideTimer = window.setTimeout(function () {
        document.documentElement.classList.remove('cp-vg-prehide');
      }, 3000);
    } catch (e) { /* never block page render */ }
  })();
</script>

<style>
  html.cp-vg-prehide media-gallery,
  html.cp-vg-prehide [id^="MediaGallery"],
  html.cp-vg-prehide .product__media-wrapper,
  html.cp-vg-prehide .product__media-list { visibility: hidden !important; }
</style>

<style>.cp-vg-native-hidden{display:none !important;}</style>

{{ 'variant-gallery-embed.css' | asset_url | stylesheet_tag }}
<script src="{{ 'variant-gallery-embed.js' | asset_url }}" defer></script>

<cp-embed-gallery
  id="cp-embed-gallery-{{ block.id }}"
  class="cp-embed-gallery"
  style="--cp-thumb-size: {{ block.settings.thumbnail_size }}px; display: none;"
  data-block-id="{{ block.id }}"
  data-native-selector="{{ block.settings.native_gallery_selector }}"
  data-scope-selector="{{ block.settings.scope_selector }}"
  data-extra-hide="{{ block.settings.extra_hide_selector }}"
  data-thumb-size="{{ block.settings.thumbnail_size }}"
  data-show-thumbs="{% if block.settings.enable_thumbnails %}1{% endif %}"
  data-thumb-pos="{{ block.settings.thumbnail_position | default: 'bottom' }}"
  data-inherit-theme="{% if block.settings.inherit_theme_settings == false %}0{% else %}1{% endif %}"
  data-model-viewer-src="{{ 'model-viewer.min.js' | asset_url }}"
>
  <div class="cp-gallery__inner"></div>
</cp-embed-gallery>

{%- endif -%}

{% schema %}
{
  "name": "Variant Image Gallery",
  "target": "head",
  "settings": [
    {
      "type": "checkbox",
      "id": "inherit_theme_settings",
      "label": "Inherit theme gallery settings (recommended)",
      "default": true,
      "info": "When on, the gallery automatically follows the theme's own product-gallery settings — thumbnail position, layout (stacked vs. with thumbs), mobile thumbnail behaviour, video looping. The settings below are ignored. Turn off only if you want to override the theme."
    },
    {
      "type": "checkbox",
      "id": "enable_thumbnails",
      "label": "Show thumbnails",
      "default": false,
      "info": "Override (ignored when Inherit theme settings is on). Off: all relevant images stack vertically at full width. On: a single main image is shown with a clickable thumbnail strip in the position chosen below."
    },
    {
      "type": "select",
      "id": "thumbnail_position",
      "label": "Thumbnail position",
      "default": "bottom",
      "options": [
        { "value": "bottom", "label": "Below main image" },
        { "value": "top", "label": "Above main image" },
        { "value": "left", "label": "Left of main image" },
        { "value": "right", "label": "Right of main image" }
      ],
      "info": "Only applies when 'Show thumbnails' is enabled. Long lists scroll horizontally (top/bottom) or vertically (left/right) with arrow controls on hover."
    },
    {
      "type": "range",
      "id": "thumbnail_size",
      "label": "Thumbnail size (px)",
      "min": 60,
      "max": 200,
      "step": 10,
      "default": 80
    },
    {
      "type": "text",
      "id": "native_gallery_selector",
      "label": "Native gallery CSS selector",
      "default": "media-gallery",
      "info": "CSS selector of your theme's native product image gallery. Default works for Dawn theme. For other themes inspect the gallery element and enter its tag or class (e.g. .product__media-wrapper)."
    },
    {
      "type": "text",
      "id": "scope_selector",
      "label": "Product container selector (optional)",
      "info": "Restricts the native gallery search to this container so quick-view / modal galleries elsewhere on the page are not matched. Leave empty for the whole page."
    },
    {
      "type": "text",
      "id": "extra_hide_selector",
      "label": "Extra elements to hide (optional)",
      "info": "Comma-separated CSS selectors for separate native thumbnail / zoom elements some themes render outside the gallery. Leave empty unless leftover native thumbnails appear."
    },
    {
      "type": "paragraph",
      "content": "Automatically replaces the native product gallery with variant-specific images from ContentPilot AI. Enable this embed once — no block placement needed."
    }
  ]
}
{% endschema %}
