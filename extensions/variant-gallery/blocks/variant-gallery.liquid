{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign gallery_mf      = current_variant.metafields.custom.variant_gallery
  assign has_gallery     = false
  if gallery_mf != blank and gallery_mf.value != blank and gallery_mf.value.size > 0
    assign has_gallery = true
  endif

  assign fallback_image = current_variant.featured_image | default: product.featured_image
-%}

{{ 'variant-gallery.css' | asset_url | stylesheet_tag }}
<script src="{{ 'variant-gallery.js' | asset_url }}" defer></script>

{%- comment -%}
  Embed ALL variant gallery data as JSON so the JS can switch galleries
  client-side without any additional HTTP requests.
  Section Rendering API cannot re-render app blocks, so this is the correct
  approach for theme app extensions.
{%- endcomment -%}
<script type="application/json" id="cp-gallery-data-{{ section.id }}">
  {
    {%- for variant in product.variants -%}
      {%- assign vg = variant.metafields.custom.variant_gallery -%}
      {{ variant.id | json }}: [
        {%- if vg != blank and vg.value != blank and vg.value.size > 0 -%}
          {%- for img in vg.value -%}
            {
              "src_400":  {{ img | image_url: width: 400  | json }},
              "src_800":  {{ img | image_url: width: 800  | json }},
              "src_1200": {{ img | image_url: width: 1200 | json }},
              "thumb":    {{ img | image_url: width: 160  | json }},
              "alt":      {{ variant.title | json }}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        {%- endif -%}
      ]{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  }
</script>

<cp-variant-gallery
  class="cp-variant-gallery"
  style="--cp-thumb-size: {{ block.settings.thumbnail_size }}px;"
  data-section-id="{{ section.id }}"
  data-current-variant="{{ current_variant.id }}"
>
  <div class="cp-gallery__inner">
    {%- if has_gallery -%}

      <div class="cp-gallery__main">
        {%- assign first_img = gallery_mf.value | first -%}
        <img
          class="cp-gallery__main-image"
          src="{{ first_img | image_url: width: 800 }}"
          srcset="
            {{ first_img | image_url: width: 400 }}  400w,
            {{ first_img | image_url: width: 800 }}  800w,
            {{ first_img | image_url: width: 1200 }} 1200w
          "
          sizes="(min-width: 1024px) 50vw, 100vw"
          alt="{{ current_variant.title | escape }}"
          loading="eager"
          width="{{ first_img.width }}"
          height="{{ first_img.height }}"
        >
      </div>

      {%- if gallery_mf.value.size > 1 -%}
        <div class="cp-gallery__thumbs">
          {%- for img in gallery_mf.value -%}
            <button
              class="cp-gallery__thumb{% if forloop.first %} is-active{% endif %}"
              type="button"
              data-src-400="{{ img | image_url: width: 400 }}"
              data-src-800="{{ img | image_url: width: 800 }}"
              data-src-1200="{{ img | image_url: width: 1200 }}"
              aria-label="{{ 'blocks.variant_gallery.thumbnail_label' | t: index: forloop.index }}"
            >
              <img
                src="{{ img | image_url: width: 160 }}"
                alt="{{ current_variant.title | escape }} {{ forloop.index }}"
                loading="lazy"
                width="160"
                height="160"
              >
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

    {%- elsif fallback_image -%}

      <div class="cp-gallery__main cp-gallery__main--fallback">
        <img
          class="cp-gallery__main-image"
          src="{{ fallback_image | image_url: width: 800 }}"
          srcset="
            {{ fallback_image | image_url: width: 400 }}  400w,
            {{ fallback_image | image_url: width: 800 }}  800w,
            {{ fallback_image | image_url: width: 1200 }} 1200w
          "
          sizes="(min-width: 1024px) 50vw, 100vw"
          alt="{{ product.title | escape }}"
          loading="eager"
          width="{{ fallback_image.width }}"
          height="{{ fallback_image.height }}"
        >
      </div>

    {%- endif -%}
  </div>
</cp-variant-gallery>

{% schema %}
{
  "name": "Variant Image Gallery",
  "target": "section",
  "settings": [
    {
      "type": "range",
      "id": "thumbnail_size",
      "label": "Thumbnail size (px)",
      "min": 60,
      "max": 160,
      "step": 10,
      "default": 80
    },
    {
      "type": "paragraph",
      "content": "Displays variant-specific images stored by ContentPilot AI in the custom.variant_gallery metafield. Add variant images via the app's Image Manager."
    }
  ]
}
{% endschema %}
