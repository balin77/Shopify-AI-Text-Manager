{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign gallery_mf      = current_variant.metafields.custom.variant_gallery
  assign has_gallery     = false
  if gallery_mf != blank and gallery_mf.value != blank and gallery_mf.value.size > 0
    assign has_gallery = true
  endif

  assign fallback_image = current_variant.featured_image | default: product.featured_image
-%}

{%- comment -%}
  Embed ALL variant gallery data as JSON so the JS can switch galleries
  client-side without any additional HTTP requests.
  Section Rendering API cannot re-render app blocks, so this is the correct
  approach for theme app extensions.
{%- endcomment -%}
<script type="application/json" id="cp-gallery-data-{{ section.id }}">
  {
    {%- for variant in product.variants -%}
      {%- assign vg = variant.metafields.custom.variant_gallery -%}
      {{ variant.id | json }}: [
        {%- if vg != blank and vg.value != blank and vg.value.size > 0 -%}
          {%- for img in vg.value -%}
            {
              "src_400":  {{ img | image_url: width: 400  | json }},
              "src_800":  {{ img | image_url: width: 800  | json }},
              "src_1200": {{ img | image_url: width: 1200 | json }},
              "thumb":    {{ img | image_url: width: 160  | json }},
              "alt":      {{ variant.title | json }}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        {%- endif -%}
      ]{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  }
</script>

<cp-variant-gallery
  class="cp-variant-gallery"
  style="--cp-thumb-size: {{ block.settings.thumbnail_size }}px;"
  data-section-id="{{ section.id }}"
  data-current-variant="{{ current_variant.id }}"
>
  <div class="cp-gallery__inner">
    {%- if has_gallery -%}

      <div class="cp-gallery__main">
        {%- assign first_img = gallery_mf.value | first -%}
        <img
          class="cp-gallery__main-image"
          src="{{ first_img | image_url: width: 800 }}"
          srcset="
            {{ first_img | image_url: width: 400 }}  400w,
            {{ first_img | image_url: width: 800 }}  800w,
            {{ first_img | image_url: width: 1200 }} 1200w
          "
          sizes="(min-width: 1024px) 50vw, 100vw"
          alt="{{ current_variant.title | escape }}"
          loading="eager"
          width="800"
        >
      </div>

      {%- if gallery_mf.value.size > 1 -%}
        <div class="cp-gallery__thumbs">
          {%- for img in gallery_mf.value -%}
            <button
              class="cp-gallery__thumb{% if forloop.first %} is-active{% endif %}"
              type="button"
              data-src-400="{{ img | image_url: width: 400 }}"
              data-src-800="{{ img | image_url: width: 800 }}"
              data-src-1200="{{ img | image_url: width: 1200 }}"
              aria-label="{{ 'blocks.variant_gallery.thumbnail_label' | t: index: forloop.index }}"
            >
              <img
                src="{{ img | image_url: width: 160 }}"
                alt="{{ current_variant.title | escape }} {{ forloop.index }}"
                loading="lazy"
                width="160"
                height="160"
              >
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

    {%- elsif fallback_image -%}

      <div class="cp-gallery__main cp-gallery__main--fallback">
        <img
          class="cp-gallery__main-image"
          src="{{ fallback_image | image_url: width: 800 }}"
          srcset="
            {{ fallback_image | image_url: width: 400 }}  400w,
            {{ fallback_image | image_url: width: 800 }}  800w,
            {{ fallback_image | image_url: width: 1200 }} 1200w
          "
          sizes="(min-width: 1024px) 50vw, 100vw"
          alt="{{ product.title | escape }}"
          loading="eager"
          width="800"
        >
      </div>

    {%- endif -%}
  </div>
</cp-variant-gallery>

{% stylesheet %}
  cp-variant-gallery {
    display: block;
  }

  .cp-gallery__inner {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .cp-gallery__main {
    border-radius: 4px;
    overflow: hidden;
    background: #f5f5f5;
  }

  .cp-gallery__main-image {
    display: block;
    width: 100%;
    height: auto;
    transition: opacity 0.18s ease;
  }

  .cp-gallery__main-image.cp-is-loading {
    opacity: 0.4;
  }

  .cp-gallery__thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .cp-gallery__thumb {
    flex-shrink: 0;
    padding: 0;
    background: transparent;
    border: 2px solid transparent;
    border-radius: 4px;
    cursor: pointer;
    overflow: hidden;
    transition: border-color 0.15s ease;
  }

  .cp-gallery__thumb:hover {
    border-color: rgba(0, 0, 0, 0.25);
  }

  .cp-gallery__thumb.is-active {
    border-color: currentColor;
  }

  .cp-gallery__thumb img {
    display: block;
    width: var(--cp-thumb-size, 80px);
    height: var(--cp-thumb-size, 80px);
    object-fit: cover;
  }
{% endstylesheet %}

{% javascript %}
  class CpVariantGallery extends HTMLElement {
    connectedCallback() {
      this._data     = this._loadData();
      this._mainImg  = this.querySelector('.cp-gallery__main-image');
      this._thumbsEl = this.querySelector('.cp-gallery__thumbs');

      this._bindThumbs();

      // Dawn Theme: dispatches 'variant:change' on the document
      document.addEventListener('variant:change', (e) => {
        const id = e.detail?.variant?.id;
        if (id) this._switchVariant(id);
      });

      // Universal fallback: native change on any variant selector
      document.addEventListener('change', (e) => {
        if (e.target.matches('[name="id"]')) {
          this._switchVariant(Number(e.target.value));
        }
      });
    }

    _loadData() {
      const el = document.getElementById('cp-gallery-data-' + this.dataset.sectionId);
      if (!el) return {};
      try { return JSON.parse(el.textContent); } catch (_) { return {}; }
    }

    _bindThumbs() {
      this.querySelectorAll('.cp-gallery__thumb').forEach((thumb) => {
        thumb.addEventListener('click', () => this._activateThumb(thumb));
      });
    }

    _activateThumb(thumb) {
      if (!this._mainImg) return;
      this._mainImg.src    = thumb.dataset.src800;
      this._mainImg.srcset = [
        thumb.dataset.src400  + ' 400w',
        thumb.dataset.src800  + ' 800w',
        thumb.dataset.src1200 + ' 1200w',
      ].join(', ');
      this.querySelectorAll('.cp-gallery__thumb').forEach((t) => t.classList.remove('is-active'));
      thumb.classList.add('is-active');
    }

    _switchVariant(variantId) {
      const images = this._data[variantId];
      const inner  = this.querySelector('.cp-gallery__inner');
      if (!inner) return;

      if (!images || images.length === 0) {
        // No gallery for this variant — clear block silently
        inner.innerHTML = '';
        return;
      }

      const first = images[0];

      // Build main image
      const mainHtml = `
        <div class="cp-gallery__main">
          <img
            class="cp-gallery__main-image"
            src="${first.src_800}"
            srcset="${first.src_400} 400w, ${first.src_800} 800w, ${first.src_1200} 1200w"
            sizes="(min-width: 1024px) 50vw, 100vw"
            alt="${this._esc(first.alt)}"
            loading="eager"
            width="800"
          >
        </div>`;

      // Build thumbnails (only if more than one image)
      let thumbsHtml = '';
      if (images.length > 1) {
        const thumbItems = images.map((img, i) => `
          <button
            class="cp-gallery__thumb${i === 0 ? ' is-active' : ''}"
            type="button"
            data-src-400="${img.src_400}"
            data-src-800="${img.src_800}"
            data-src-1200="${img.src_1200}"
          >
            <img src="${img.thumb}" alt="${this._esc(img.alt)} ${i + 1}" loading="lazy" width="160" height="160">
          </button>`).join('');
        thumbsHtml = `<div class="cp-gallery__thumbs">${thumbItems}</div>`;
      }

      inner.innerHTML = mainHtml + thumbsHtml;

      // Re-cache references after DOM rebuild
      this._mainImg  = this.querySelector('.cp-gallery__main-image');
      this._thumbsEl = this.querySelector('.cp-gallery__thumbs');
      this._bindThumbs();
    }

    _esc(str) {
      return String(str ?? '').replace(/&/g, '&amp;').replace(/"/g, '&quot;');
    }
  }

  customElements.define('cp-variant-gallery', CpVariantGallery);
{% endjavascript %}

{% schema %}
{
  "name": "Variant Image Gallery",
  "target": "section",
  "settings": [
    {
      "type": "range",
      "id": "thumbnail_size",
      "label": "Thumbnail size (px)",
      "min": 60,
      "max": 160,
      "step": 10,
      "default": 80
    },
    {
      "type": "paragraph",
      "content": "Displays variant-specific images stored by ContentPilot AI in the custom.variant_gallery metafield. Add variant images via the app's Image Manager."
    }
  ]
}
{% endschema %}
