{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign gallery_mf      = current_variant.metafields.custom.variant_gallery
  assign has_gallery     = false
  if gallery_mf != blank and gallery_mf.value != blank
    assign has_gallery = true
  endif
  assign fallback_image = current_variant.featured_image | default: product.featured_image
-%}

{{ 'variant-gallery.css' | asset_url | stylesheet_tag }}
<script src="{{ 'variant-gallery.js' | asset_url }}" defer></script>

{%- comment -%}
  Embed ALL variant gallery data as JSON so the JS can switch galleries
  client-side without extra HTTP requests. The wrapper is ALWAYS rendered
  (never empty) and always carries block.shopify_attributes so the theme
  editor can register/position the app block.
{%- endcomment -%}
<script type="application/json" id="cp-gallery-data-{{ block.id }}">
  {
    {%- if product != blank -%}
      {%- for variant in product.variants -%}
        {%- assign vg = variant.metafields.custom.variant_gallery -%}
        "{{ variant.id }}": [
          {%- assign cp_has_any = false -%}
          {%- if variant.featured_image != blank -%}
            {%- assign vfi = variant.featured_image -%}
            {
              "src_400":  {{ vfi | image_url: width: 400  | json }},
              "src_800":  {{ vfi | image_url: width: 800  | json }},
              "src_1200": {{ vfi | image_url: width: 1200 | json }},
              "thumb":    {{ vfi | image_url: width: 160  | json }},
              "alt":      {{ variant.title | json }}
            }
            {%- assign cp_has_any = true -%}
          {%- endif -%}
          {%- if vg != blank and vg.value != blank -%}
            {%- for img in vg.value -%}
              {%- if cp_has_any %},{% endif -%}
              {
                "src_400":  {{ img | image_url: width: 400  | json }},
                "src_800":  {{ img | image_url: width: 800  | json }},
                "src_1200": {{ img | image_url: width: 1200 | json }},
                "thumb":    {{ img | image_url: width: 160  | json }},
                "alt":      {{ variant.title | json }}
              }
              {%- assign cp_has_any = true -%}
            {%- endfor -%}
          {%- endif -%}
        ]{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    {%- endif -%}
  }
</script>

<cp-variant-gallery
  {{ block.shopify_attributes }}
  class="cp-variant-gallery"
  style="--cp-thumb-size: {{ block.settings.thumbnail_size }}px;"
  data-block-id="{{ block.id }}"
  data-current-variant="{{ current_variant.id }}"
>
  <div class="cp-gallery__inner">
    {%- if product == blank -%}

      <p class="cp-gallery__placeholder">Variant Image Gallery — preview on a product page to see variant images.</p>

    {%- elsif has_gallery or current_variant.featured_image != blank -%}

      {%- if current_variant.featured_image != blank -%}
        {%- assign main_img = current_variant.featured_image -%}
      {%- else -%}
        {%- assign main_img = gallery_mf.value | first -%}
      {%- endif -%}

      <div class="cp-gallery__main">
        {{
          main_img
          | image_url: width: 800
          | image_tag:
            class: 'cp-gallery__main-image',
            loading: 'eager',
            sizes: '(min-width: 1024px) 50vw, 100vw',
            widths: '400, 800, 1200',
            alt: current_variant.title
        }}
      </div>

      <div class="cp-gallery__thumbs">
        {%- if current_variant.featured_image != blank -%}
          {%- assign vfi = current_variant.featured_image -%}
          <button
            class="cp-gallery__thumb is-active"
            type="button"
            data-src-sm="{{ vfi | image_url: width: 400 | escape }}"
            data-src-md="{{ vfi | image_url: width: 800 | escape }}"
            data-src-lg="{{ vfi | image_url: width: 1200 | escape }}"
            aria-label="{{ 'blocks.variant_gallery.thumbnail_label' | t: index: 1 }}"
          >
            {{ vfi | image_url: width: 160 | image_tag: loading: 'lazy', width: 160, height: 160, alt: current_variant.title }}
          </button>
        {%- endif -%}
        {%- if has_gallery -%}
          {%- for img in gallery_mf.value -%}
            <button
              class="cp-gallery__thumb{% if forloop.first and current_variant.featured_image == blank %} is-active{% endif %}"
              type="button"
              data-src-sm="{{ img | image_url: width: 400 | escape }}"
              data-src-md="{{ img | image_url: width: 800 | escape }}"
              data-src-lg="{{ img | image_url: width: 1200 | escape }}"
              aria-label="{{ 'blocks.variant_gallery.thumbnail_label' | t: index: forloop.index }}"
            >
              {{ img | image_url: width: 160 | image_tag: loading: 'lazy', width: 160, height: 160, alt: current_variant.title }}
            </button>
          {%- endfor -%}
        {%- endif -%}
      </div>

    {%- elsif fallback_image -%}

      <div class="cp-gallery__main cp-gallery__main--fallback">
        {{
          fallback_image
          | image_url: width: 800
          | image_tag:
            class: 'cp-gallery__main-image',
            loading: 'eager',
            sizes: '(min-width: 1024px) 50vw, 100vw',
            widths: '400, 800, 1200',
            alt: product.title
        }}
      </div>

    {%- else -%}

      <p class="cp-gallery__placeholder">No variant images found for this product.</p>

    {%- endif -%}
  </div>
</cp-variant-gallery>

{% schema %}
{
  "name": "Variant Image Gallery",
  "target": "section",
  "settings": [
    {
      "type": "range",
      "id": "thumbnail_size",
      "label": "Thumbnail size (px)",
      "min": 60,
      "max": 160,
      "step": 10,
      "default": 80
    },
    {
      "type": "paragraph",
      "content": "Displays variant-specific images stored by ContentPilot AI in the custom.variant_gallery metafield. Add variant images via the app's Image Manager."
    }
  ]
}
{% endschema %}
