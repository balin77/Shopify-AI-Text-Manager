{%- comment -%}
  App Embed Block (target: body) — runs on every product page automatically.
  Finds the native gallery in the DOM, hides it when variant-specific images
  exist in custom.variant_gallery, and injects the custom gallery in its place.
  On variants without metafield images the native gallery is restored.
{%- endcomment -%}

{%- if product != blank -%}

{%- comment -%}
  R3-H1: `| json` escapes JSON syntax but NOT `<`, so an attacker-influenced
  variant.title containing `</script><script>…` would break out of this
  JSON island and inject script regardless of the JS-side _esc(). Every
  free-text value interpolated below MUST additionally neutralise `<`/`>`
  by replacing them with their \uXXXX JSON escapes (JSON.parse restores
  them, so data is unchanged). Image URLs are Shopify CDN and
  IDs/dimensions are numeric, so only variant.title needs this.
{%- endcomment -%}
<script type="application/json" id="cp-embed-data-{{ block.id }}">
  {
    {%- for variant in product.variants -%}
      {%- assign vg = variant.metafields.custom.variant_gallery -%}
      "{{ variant.id }}": [
        {%- assign cp_has_any = false -%}
        {%- if variant.featured_image != blank -%}
          {%- assign vfi = variant.featured_image -%}
          {
            "src_400":  {{ vfi | image_url: width: 400  | json }},
            "src_800":  {{ vfi | image_url: width: 800  | json }},
            "src_1200": {{ vfi | image_url: width: 1200 | json }},
            "thumb":    {{ vfi | image_url: width: 160  | json }},
            "w":        {{ vfi.width  | json }},
            "h":        {{ vfi.height | json }},
            "alt":      {{ variant.title | json | replace: "<", "\u003c" | replace: ">", "\u003e" }}
          }
          {%- assign cp_has_any = true -%}
        {%- endif -%}
        {%- if vg != blank and vg.value != blank -%}
          {%- for img in vg.value -%}
            {%- assign cp_src = img | image_url: width: 800 -%}
            {%- if cp_src != blank -%}
              {%- if cp_has_any %},{% endif -%}
              {%- assign cp_w = img.preview_image.width  | default: img.width -%}
              {%- assign cp_h = img.preview_image.height | default: img.height -%}
              {
                "src_400":  {{ img | image_url: width: 400  | json }},
                "src_800":  {{ cp_src | json }},
                "src_1200": {{ img | image_url: width: 1200 | json }},
                "thumb":    {{ img | image_url: width: 160  | json }},
                "w":        {{ cp_w | json }},
                "h":        {{ cp_h | json }},
                "alt":      {{ variant.title | json | replace: "<", "\u003c" | replace: ">", "\u003e" }}
              }
              {%- assign cp_has_any = true -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      ]{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  }
</script>

{%- comment -%}
  FOUC fix: the native gallery is otherwise hidden only later by the deferred
  controller (after DOMContentLoaded), so it flashes fully visible on every
  page load. This synchronous inline script runs the moment the parser
  reaches it (the native gallery is earlier in <body>, so it is already in
  the DOM): if the *current* variant has metafield images it resolves the
  exact native gallery element — mirroring the controller's scope + selector
  resolution — and adds the fixed class `cp-vg-native-hidden` directly to it,
  so it is hidden before/at first paint instead of after the controller boots.

  Security: NO merchant-controlled value is ever interpolated into CSS or
  HTML here. The CSS rule is a fixed class. Merchant selector settings are
  passed only as `| json` JS strings, additionally `<`-stripped (same
  hardening posture as the JSON island above) so a `</script>` in a setting
  cannot break out. Element-scoped (respects scope_selector) so quick-view /
  recommended-product galleries elsewhere on the page are not hidden.

  Variants WITHOUT images never get the class → native shows normally (no
  reverse flash). A 3s fail-safe reveals the native gallery again if the
  controller never mounts; the controller cancels it once it takes over.
{%- endcomment -%}
{%- comment -%}
  `| json` handles quotes/backslashes for the JS string context. We
  additionally strip `<` only: a CSS selector never legitimately contains
  `<`, and every script-context breakout (`</script>`, `<!--`) requires it,
  so this removes the breakout vector losslessly (defence-in-depth on top
  of `| json`). `>` is NOT stripped — it is the legitimate CSS child
  combinator (`.a > .b`) and carries no breakout risk inside a JS string.
{%- endcomment -%}
{%- assign cp_native_sel  = block.settings.native_gallery_selector | json | replace: "<", "" -%}
{%- assign cp_scope_sel   = block.settings.scope_selector          | json | replace: "<", "" -%}
{%- assign cp_extra_sel   = block.settings.extra_hide_selector     | json | replace: "<", "" -%}
<style>.cp-vg-native-hidden{display:none !important;}</style>
<script>
  (function () {
    try {
      var el = document.getElementById('cp-embed-data-{{ block.id }}');
      if (!el) return;
      var data = JSON.parse(el.textContent);

      var scopeSel  = {{ cp_scope_sel }};
      var configured = {{ cp_native_sel }};
      var extraSel  = {{ cp_extra_sel }};
      var defaultId = {{ product.selected_or_first_available_variant.id | json }};

      var root = document;
      if (scopeSel) { try { root = document.querySelector(scopeSel) || document; } catch (e) {} }

      // Mirror the controller's _resolveVariantId order: live [name="id"]
      // (also covers sold-out variants) → ?variant= → first/selected.
      var id = null;
      try { var inp = root.querySelector('[name="id"]'); if (inp && inp.value) id = String(inp.value); } catch (e) {}
      if (!id) { try { id = new URL(window.location.href).searchParams.get('variant'); } catch (e) {} }
      if (!id && defaultId != null) id = String(defaultId);

      var imgs = (id && data) ? data[id] : null;
      if (!(imgs && imgs.length)) return;

      // Mirror the controller's _selectors fallback list.
      var sels = [configured, 'media-gallery', '[id^="MediaGallery"]', '.product__media-wrapper', '.product__media-list'];
      var native = null;
      for (var i = 0; i < sels.length; i++) {
        var s = sels[i]; if (!s) continue;
        try { var c = root.querySelector(s); if (c) { native = c; break; } } catch (e) {}
      }
      if (!native) return;

      var extra = [];
      if (extraSel) { try { extra = Array.prototype.slice.call(root.querySelectorAll(extraSel)); } catch (e) {} }
      native.classList.add('cp-vg-native-hidden');
      extra.forEach(function (x) { x.classList.add('cp-vg-native-hidden'); });

      window.__cpVgFouc = { timer: window.setTimeout(function () {
        if (!document.querySelector('.cp-embed-gallery .cp-gallery__main-image')) {
          native.classList.remove('cp-vg-native-hidden');
          extra.forEach(function (x) { x.classList.remove('cp-vg-native-hidden'); });
        }
      }, 3000) };
    } catch (e) { /* never block page render */ }
  })();
</script>

<cp-embed-gallery
  id="cp-embed-gallery-{{ block.id }}"
  class="cp-embed-gallery"
  style="--cp-thumb-size: {{ block.settings.thumbnail_size }}px; display: none;"
  data-block-id="{{ block.id }}"
  data-native-selector="{{ block.settings.native_gallery_selector }}"
  data-scope-selector="{{ block.settings.scope_selector }}"
  data-extra-hide="{{ block.settings.extra_hide_selector }}"
  data-thumb-size="{{ block.settings.thumbnail_size }}"
  data-debug="{% if block.settings.debug_logs %}1{% endif %}"
>
  <div class="cp-gallery__inner"></div>
</cp-embed-gallery>

{{ 'variant-gallery-embed.css' | asset_url | stylesheet_tag }}
<script src="{{ 'variant-gallery-embed.js' | asset_url }}" defer></script>

{%- endif -%}

{% schema %}
{
  "name": "Variant Image Gallery",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "native_gallery_selector",
      "label": "Native gallery CSS selector",
      "default": "media-gallery",
      "info": "CSS selector of your theme's native product image gallery. Default works for Dawn theme. For other themes inspect the gallery element and enter its tag or class (e.g. .product__media-wrapper)."
    },
    {
      "type": "text",
      "id": "scope_selector",
      "label": "Product container selector (optional)",
      "info": "Restricts the native gallery search to this container so quick-view / modal galleries elsewhere on the page are not matched. Leave empty for the whole page."
    },
    {
      "type": "text",
      "id": "extra_hide_selector",
      "label": "Extra elements to hide (optional)",
      "info": "Comma-separated CSS selectors for separate native thumbnail / zoom elements some themes render outside the gallery. Leave empty unless leftover native thumbnails appear."
    },
    {
      "type": "checkbox",
      "id": "debug_logs",
      "label": "Enable debug logging in browser console",
      "default": false
    },
    {
      "type": "range",
      "id": "thumbnail_size",
      "label": "Thumbnail size (px)",
      "min": 60,
      "max": 160,
      "step": 10,
      "default": 80
    },
    {
      "type": "paragraph",
      "content": "Automatically replaces the native product gallery with variant-specific images from ContentPilot AI. Enable this embed once — no block placement needed."
    }
  ]
}
{% endschema %}
