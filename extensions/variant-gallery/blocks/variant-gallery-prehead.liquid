{%- comment -%}
  App embed block, target: head. Shopify injects this just before
  </head>, so it is parsed during <head> parsing — BEFORE the <body>
  and the theme's native product gallery are painted. This is the only
  place an app can hide the native gallery truly pre-paint; the
  "Variant Image Gallery" body embed renders at the end of <body>,
  which is too late and is what caused the residual flash.

  Scope of THIS block (setter only):
    • emit the blanket <style> (visibility:hidden, layout reserved)
    • add `cp-vg-prehide` to <html> — but ONLY if the *current* variant
      actually has gallery images, so products/variants the app does
      not manage are never hidden. This APPROXIMATES the body data
      island decision (featured_image OR custom.variant_gallery present)
      but does not re-check per-image image_url resolvability: a variant
      whose variant_gallery is set but whose every image URL is empty
      (and no featured_image) is pre-hidden here yet yields an empty
      body array → the body releaser shows native after a brief,
      self-healing blank for that one unmanaged variant. Rare, bounded.
    • register window.__cpVgFouc.prehideTimer — a 3s fail-safe that
      reveals the native gallery if the body embed is disabled/blocked,
      so the page is never stranded.

  RELEASING the class is owned entirely by the body embed
  (per-element bootstrap `finally` + controller + timer-cancel). Enable
  both embeds together; this one alone only hides for 3s then reveals.

  Constraints: head app embeds only have Global Liquid scope (`product`
  is available on product pages). At <head> parse time the <body> form
  does not exist yet, so the current variant is resolved from the
  ?variant= URL param else product.selected_or_first_available_variant
  (the body bootstrap, which can read [name="id"], corrects + releases
  later). Plain <style>/<script> only — the bundled Shopify stylesheet
  tag is forbidden in app blocks.

  Security: only numeric variant ids are interpolated (no free text),
  so there is no JSON/script injection surface here.
{%- endcomment -%}
{%- if product != blank -%}
{%- comment -%} CANONICAL native-selector list. Kept in sync with the
  dormant copy in variant-gallery-embed.liquid and the _selectors arrays
  in that block's bootstrap + assets/variant-gallery-embed.js. {%- endcomment -%}
<style>
  html.cp-vg-prehide media-gallery,
  html.cp-vg-prehide [id^="MediaGallery"],
  html.cp-vg-prehide .product__media-wrapper,
  html.cp-vg-prehide .product__media-list { visibility: hidden !important; }
</style>
<script>
  (function () {
    try {
      var withImages = {
        {%- assign cp_first = true -%}
        {%- for variant in product.variants -%}
          {%- assign vg = variant.metafields.custom.variant_gallery -%}
          {%- assign cp_has = false -%}
          {%- if variant.featured_image != blank -%}{%- assign cp_has = true -%}{%- endif -%}
          {%- if vg != blank and vg.value != blank -%}{%- assign cp_has = true -%}{%- endif -%}
          {%- if cp_has -%}
            {%- unless cp_first %},{% endunless -%}"{{ variant.id }}":1
            {%- assign cp_first = false -%}
          {%- endif -%}
        {%- endfor -%}
      };
      var id = null;
      try { id = new URL(window.location.href).searchParams.get('variant'); } catch (e) {}
      if (!id) id = {{ product.selected_or_first_available_variant.id | json }};
      if (id == null) return;
      if (!withImages[String(id)]) return;
      document.documentElement.classList.add('cp-vg-prehide');
      window.__cpVgFouc = window.__cpVgFouc || {};
      window.__cpVgFouc.prehideTimer = window.setTimeout(function () {
        document.documentElement.classList.remove('cp-vg-prehide');
      }, 3000);
    } catch (e) { /* never block page render */ }
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Variant Gallery Pre-hide",
  "target": "head",
  "settings": [
    {
      "type": "paragraph",
      "content": "Removes the brief flash of the theme's native product gallery on page load by hiding it before the page paints. Enable this together with the 'Variant Image Gallery' app embed. Safe to leave on: a 3-second fail-safe restores the native gallery if the main embed is missing or blocked."
    }
  ]
}
{% endschema %}
